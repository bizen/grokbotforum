---
import type { Language } from '../utils/i18n';
import { t, getLocalizedPath, getAlternateLanguage } from '../utils/i18n';

interface Props {
  title: string;
  description?: string;
  lang: Language;
  alternateUrl?: string;
  ogType?: 'website' | 'article';
}

const { title, description, lang, alternateUrl, ogType = 'website' } = Astro.props;
const siteTitle = t(lang, 'site.title');
const fullTitle = title ? `${title} - ${siteTitle}` : siteTitle;
const siteDescription = description || t(lang, 'site.description');
const currentUrl = new URL(Astro.url.pathname, Astro.site);
const alternateLang = getAlternateLanguage(lang);
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={siteDescription} />
    
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={siteDescription} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={currentUrl} />
    <meta property="og:site_name" content={siteTitle} />
    
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={siteDescription} />
    
    {alternateUrl && (
      <>
        <link rel="alternate" hreflang={alternateLang} href={new URL(alternateUrl, Astro.site).href} />
        <link rel="alternate" hreflang={lang} href={currentUrl.href} />
      </>
    )}
    
    <link rel="alternate" type="application/rss+xml" title={`${siteTitle} RSS (${lang})`} href={`${Astro.site}${getLocalizedPath('/feed.xml', lang)}`} />
    
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <style is:global>
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }
      
      :root {
        --color-text: #0a0a0a;
        --color-text-muted: #666666;
        --color-bg: #ffffff;
        --color-bg-subtle: #fafafa;
        --color-border: #e8e8e8;
        --color-card-bg: #ffffff;
        --color-card-border: #f0f0f0;
        --color-accent: #000000;
        --color-accent-hover: #333333;
        --font-sans: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Noto Sans JP', 'Hiragino Sans', 'Yu Gothic', system-ui, sans-serif;
        --font-mono: ui-monospace, 'SF Mono', Monaco, 'Cascadia Code', 'Roboto Mono', Consolas, monospace;
        --content-width: 820px;
        --spacing-unit: 1rem;
        --nav-height: 60px;
        --transition-speed: 0.2s;
      }
      
      @media (prefers-color-scheme: dark) {
        :root {
          --color-text: #ffffff;
          --color-text-muted: #a0a0a0;
          --color-bg: #0a0a0a;
          --color-bg-subtle: #141414;
          --color-border: #2a2a2a;
          --color-card-bg: #141414;
          --color-card-border: #222222;
          --color-accent: #ffffff;
          --color-accent-hover: #cccccc;
        }
      }
      
      html {
        scroll-behavior: smooth;
      }
      
      body {
        font-family: var(--font-sans);
        line-height: 1.7;
        color: var(--color-text);
        background: var(--color-bg);
        font-size: 16px;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        transition: background-color var(--transition-speed) ease;
      }
      
      a {
        color: var(--color-text);
        text-decoration: none;
        transition: opacity var(--transition-speed) ease;
      }
      
      a:hover {
        opacity: 0.65;
      }
      
      h1, h2, h3, h4, h5, h6 {
        line-height: 1.2;
        margin-bottom: 1rem;
        font-weight: 600;
        letter-spacing: -0.02em;
      }
      
      h1 {
        font-size: 3rem;
        font-weight: 600;
      }
      
      h2 {
        font-size: 2rem;
        font-weight: 600;
      }
      
      h3 {
        font-size: 1.5rem;
      }
      
      p {
        margin-bottom: 1rem;
      }
      
      ul, ol {
        margin-bottom: 1rem;
        padding-left: 1.5rem;
      }
      
      code {
        font-family: var(--font-mono);
        font-size: 0.9em;
        background: var(--color-bg-subtle);
        padding: 0.2em 0.4em;
        border-radius: 4px;
      }
      
      pre {
        overflow-x: auto;
        margin-bottom: 1rem;
        padding: 1.25rem;
        background: var(--color-bg-subtle);
        border-radius: 8px;
        border: 1px solid var(--color-border);
      }
      
      pre code {
        background: none;
        padding: 0;
      }
      
      @media (max-width: 768px) {
        h1 {
          font-size: 2.25rem;
        }
        
        h2 {
          font-size: 1.75rem;
        }
      }
    </style>
  </head>
  <body>
    <header>
      <div class="container">
        <div class="header-content">
          <h1 class="site-title">
            <a href={getLocalizedPath('/', lang)}>{siteTitle}</a>
          </h1>
          <nav>
            <a href={getLocalizedPath('/', lang)}>{t(lang, 'nav.home')}</a>
            <a href={getLocalizedPath('/bots/', lang)}>{t(lang, 'nav.bots')}</a>
            <a href={getLocalizedPath('/templates/', lang)}>{t(lang, 'nav.templates')}</a>
            <span class="separator">|</span>
            <a href={alternateUrl || getLocalizedPath('/', alternateLang)} class="lang-toggle">
              {alternateLang === 'ja' ? '日本語' : 'English'}
            </a>
          </nav>
        </div>
      </div>
    </header>
    
    <main>
      <div class="container">
        <slot />
      </div>
    </main>
    
    <footer>
      <div class="container">
        <div class="footer-content">
          <p class="unofficial-notice">{lang === 'ja' ? '非公式ファンサイト' : 'Unofficial fan site'}</p>
          <p>&copy; {new Date().getFullYear()} Grok Bot Forum</p>
        </div>
      </div>
    </footer>
    
    <style>
      header {
        position: sticky;
        top: 0;
        background: var(--color-bg);
        border-bottom: 1px solid var(--color-border);
        padding: 0;
        height: var(--nav-height);
        z-index: 100;
        backdrop-filter: blur(8px);
        transition: background-color var(--transition-speed) ease;
      }
      
      @supports (backdrop-filter: blur(8px)) {
        header {
          background: rgba(255, 255, 255, 0.8);
        }
        
        @media (prefers-color-scheme: dark) {
          header {
            background: rgba(10, 10, 10, 0.8);
          }
        }
      }
      
      .container {
        max-width: var(--content-width);
        margin: 0 auto;
        padding: 0 2rem;
      }
      
      .header-content {
        display: flex;
        justify-content: space-between;
        align-items: center;
        height: var(--nav-height);
        gap: 2rem;
      }
      
      .site-title {
        font-size: 1.125rem;
        margin: 0;
        font-weight: 600;
        letter-spacing: -0.01em;
      }
      
      .site-title a {
        color: var(--color-text);
        text-decoration: none;
      }
      
      nav {
        display: flex;
        gap: 1.75rem;
        align-items: center;
        font-size: 0.9375rem;
      }
      
      nav .separator {
        color: var(--color-border);
        user-select: none;
      }
      
      nav a {
        white-space: nowrap;
        position: relative;
      }
      
      nav .lang-toggle {
        font-weight: 500;
      }
      
      main {
        min-height: calc(100vh - var(--nav-height) - 200px);
        padding-top: 4rem;
        padding-bottom: 6rem;
      }
      
      footer {
        border-top: 1px solid var(--color-border);
        padding: 3rem 0;
        margin-top: 4rem;
      }
      
      .footer-content {
        display: flex;
        justify-content: space-between;
        align-items: center;
        color: var(--color-text-muted);
        font-size: 0.875rem;
        gap: 1rem;
        flex-wrap: wrap;
      }
      
      .unofficial-notice {
        font-size: 0.8125rem;
        opacity: 0.7;
      }
      
      @media (max-width: 768px) {
        .container {
          padding: 0 1.25rem;
        }
        
        .header-content {
          gap: 1rem;
        }
        
        nav {
          gap: 1.25rem;
          font-size: 0.875rem;
        }
        
        .site-title {
          font-size: 1rem;
        }
        
        main {
          padding-top: 2.5rem;
          padding-bottom: 4rem;
        }
        
        .footer-content {
          flex-direction: column;
          align-items: flex-start;
          gap: 0.5rem;
        }
      }
    </style>
  </body>
</html>
