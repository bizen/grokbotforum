---
import type { Language } from '../utils/i18n';
import { t, getLocalizedPath, getAlternateLanguage } from '../utils/i18n';

interface Props {
  title: string;
  description?: string;
  lang: Language;
  alternateUrl?: string;
  ogType?: 'website' | 'article';
}

const { title, description, lang, alternateUrl, ogType = 'website' } = Astro.props;
const siteTitle = t(lang, 'site.title');
const fullTitle = title ? `${title} - ${siteTitle}` : siteTitle;
const siteDescription = description || t(lang, 'site.description');
const currentUrl = new URL(Astro.url.pathname, Astro.site);
const alternateLang = getAlternateLanguage(lang);
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={siteDescription} />
    
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={siteDescription} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={currentUrl} />
    <meta property="og:site_name" content={siteTitle} />
    
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={siteDescription} />
    
    {alternateUrl && (
      <>
        <link rel="alternate" hreflang={alternateLang} href={new URL(alternateUrl, Astro.site).href} />
        <link rel="alternate" hreflang={lang} href={currentUrl.href} />
      </>
    )}
    
    <link rel="alternate" type="application/rss+xml" title={`${siteTitle} RSS (${lang})`} href={`${Astro.site}${getLocalizedPath('/feed.xml', lang)}`} />
    
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <style is:global>
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }
      
      :root {
        --color-text: #1a1a1a;
        --color-bg: #ffffff;
        --color-border: #e5e5e5;
        --color-accent: #0066cc;
        --color-accent-hover: #0052a3;
        --font-sans: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Hiragino Sans', 'Hiragino Kaku Gothic ProN', Meiryo, sans-serif;
        --font-mono: 'SF Mono', Monaco, Consolas, monospace;
        --content-width: 720px;
        --spacing-unit: 1rem;
      }
      
      body {
        font-family: var(--font-sans);
        line-height: 1.6;
        color: var(--color-text);
        background: var(--color-bg);
        font-size: 16px;
      }
      
      a {
        color: var(--color-accent);
        text-decoration: none;
      }
      
      a:hover {
        color: var(--color-accent-hover);
        text-decoration: underline;
      }
      
      h1, h2, h3, h4, h5, h6 {
        line-height: 1.3;
        margin-bottom: 0.75rem;
      }
      
      h1 {
        font-size: 2rem;
      }
      
      h2 {
        font-size: 1.5rem;
      }
      
      h3 {
        font-size: 1.25rem;
      }
      
      p {
        margin-bottom: 1rem;
      }
      
      ul, ol {
        margin-bottom: 1rem;
        padding-left: 1.5rem;
      }
      
      code {
        font-family: var(--font-mono);
        font-size: 0.9em;
        background: #f5f5f5;
        padding: 0.2em 0.4em;
        border-radius: 3px;
      }
      
      pre {
        overflow-x: auto;
        margin-bottom: 1rem;
        padding: 1rem;
        background: #f5f5f5;
        border-radius: 4px;
      }
      
      pre code {
        background: none;
        padding: 0;
      }
    </style>
  </head>
  <body>
    <header>
      <div class="container">
        <div class="header-content">
          <h1 class="site-title">
            <a href={getLocalizedPath('/', lang)}>{siteTitle}</a>
          </h1>
          <nav>
            <a href={getLocalizedPath('/', lang)}>{t(lang, 'nav.home')}</a>
            <a href={getLocalizedPath('/bots/', lang)}>{t(lang, 'nav.bots')}</a>
            <a href={getLocalizedPath('/templates/', lang)}>{t(lang, 'nav.templates')}</a>
            <span class="separator">|</span>
            <a href={alternateUrl || getLocalizedPath('/', alternateLang)} class="lang-toggle">
              {alternateLang === 'ja' ? '日本語' : 'English'}
            </a>
          </nav>
        </div>
      </div>
    </header>
    
    <main>
      <div class="container">
        <slot />
      </div>
    </main>
    
    <footer>
      <div class="container">
        <p>&copy; {new Date().getFullYear()} Grok Bot Forum</p>
      </div>
    </footer>
    
    <style>
      header {
        border-bottom: 1px solid var(--color-border);
        padding: var(--spacing-unit) 0;
        margin-bottom: calc(var(--spacing-unit) * 2);
      }
      
      .container {
        max-width: var(--content-width);
        margin: 0 auto;
        padding: 0 var(--spacing-unit);
      }
      
      .header-content {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        flex-wrap: wrap;
      }
      
      .site-title {
        font-size: 1.5rem;
        margin: 0;
      }
      
      .site-title a {
        color: var(--color-text);
        text-decoration: none;
      }
      
      .site-title a:hover {
        color: var(--color-accent);
      }
      
      nav {
        display: flex;
        gap: 1rem;
        align-items: center;
        flex-wrap: wrap;
      }
      
      nav .separator {
        color: var(--color-border);
      }
      
      nav a {
        white-space: nowrap;
      }
      
      nav .lang-toggle {
        font-weight: 500;
      }
      
      main {
        min-height: 60vh;
        margin-bottom: calc(var(--spacing-unit) * 3);
      }
      
      footer {
        border-top: 1px solid var(--color-border);
        padding: calc(var(--spacing-unit) * 2) 0;
        margin-top: calc(var(--spacing-unit) * 3);
        color: #666;
        font-size: 0.9rem;
      }
      
      @media (max-width: 600px) {
        .header-content {
          flex-direction: column;
          align-items: flex-start;
        }
        
        nav {
          width: 100%;
        }
      }
    </style>
  </body>
</html>
