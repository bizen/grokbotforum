---
import '../styles/global.css';
import { COLLECTION_META, getNavCollections } from '../lib/content';
import EnglishGate from '../components/EnglishGate.astro';
import { t, localizedPath, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  /** Machine-readable twin of this page. */
  jsonPath?: string;
  ogType?: 'website' | 'article';
  /** Share image path, generated by src/pages/og/[...slug].png.ts. */
  ogImage?: string;
  jsonLd?: Record<string, unknown>;
}

const { lang, title, description, jsonPath, ogType = 'website', ogImage = '/og/default.png', jsonLd } = Astro.props;

const site = Astro.site!;
const siteName = t(lang, 'site.name');
const fullTitle = title ? `${title} · ${siteName}` : `${siteName} — ${t(lang, 'home.title')}`;
const desc = description ?? t(lang, 'site.description');
const canonical = new URL(Astro.url.pathname, site).href;
const current = Astro.url.pathname;
const nav = (await getNavCollections(lang)).map((c) => ({
  href: localizedPath(`/${c}/`, lang),
  label: COLLECTION_META[c][lang].label,
}));
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:image" content={new URL(ogImage, site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="ja_JP" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL(ogImage, site).href} />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />

    <link rel="alternate" hreflang="en" href={new URL('/en/', site).href} />
    {jsonPath && <link rel="alternate" type="application/json" href={jsonPath} />}
    <link rel="alternate" type="text/plain" title="llms.txt" href="/llms.txt" />
    <link rel="alternate" type="application/rss+xml" title={siteName} href={localizedPath('/feed.xml', lang)} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" href="/icon-192.png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
    />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <script is:inline>
      try {
        const theme = localStorage.getItem('theme');
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="nav" data-nav>
      <div class="container nav-inner">
        <a class="nav-logo" href={localizedPath('/', lang)} aria-label="Grok Bot Forum"></a>

        <nav class="nav-links" aria-label="Primary">
          {nav.map((item) => (
            <a href={item.href} aria-current={current.startsWith(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          ))}
        </nav>

        <div class="nav-actions">
          <button class="search-trigger" type="button" data-search-open aria-label={t(lang, 'nav.search')}>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
              <circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" stroke-linecap="round" />
            </svg>
            <span class="search-trigger-label">{t(lang, 'nav.search')}</span>
            <kbd data-mod-key>⌘K</kbd>
          </button>
          <button class="icon-btn" type="button" data-theme-toggle aria-label={t(lang, 'nav.theme')}>
            <svg class="sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
              <circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
            </svg>
            <svg class="moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round" aria-hidden="true">
              <path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5Z" />
            </svg>
          </button>
          <a class="lang-link" href="/en/" hreflang="en" lang="en">EN</a>
          <button class="icon-btn menu-btn" type="button" data-menu-toggle aria-expanded="false" aria-controls="mobile-menu" aria-label={t(lang, 'nav.menu')}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
              <path d="M4 8h16M4 16h16" />
            </svg>
          </button>
        </div>
      </div>

      <div class="mobile-menu" id="mobile-menu" hidden>
        <nav class="container" aria-label="Mobile">
          {nav.map((item) => <a href={item.href}>{item.label}</a>)}
          <a href={localizedPath('/about/', lang)}>{t(lang, 'nav.about')}</a>
          <a href="/en/" hreflang="en" lang="en">English</a>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="footer">
      <div class="container footer-inner">
        <div class="footer-brand">
          <a class="wordmark" href={localizedPath('/', lang)}>{siteName}</a>
          <p>{t(lang, 'footer.unofficial')}</p>
        </div>
        <div class="footer-cols">
          <div>
            <h2>{t(lang, 'footer.site')}</h2>
            <ul>
              {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
              <li><a href={localizedPath('/about/', lang)}>{t(lang, 'nav.about')}</a></li>
            </ul>
          </div>
          <div>
            <h2>{t(lang, 'footer.data')}</h2>
            <ul>
              <li><a href={localizedPath('/agents/', lang)}>MCP</a></li>
              <li><a href="/llms.txt">llms.txt</a></li>
              <li><a href="/index.json">index.json</a></li>
              <li><a href={localizedPath('/feed.xml', lang)}>RSS</a></li>
              <li><a href="https://github.com/bizen/grokbotforum">GitHub</a></li>
            </ul>
          </div>
        </div>
      </div>
    </footer>

    <dialog class="gate-dialog" data-gate aria-label="About this site">
      <EnglishGate variant="dialog" />
    </dialog>

    <dialog class="search" data-search aria-label={t(lang, 'nav.search')} data-lang={lang} data-empty={t(lang, 'search.noResults')}>
      <div class="search-panel">
        <div class="search-field">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
            <circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" stroke-linecap="round" />
          </svg>
          <input type="search" data-search-input placeholder={t(lang, 'home.searchPlaceholder')} autocomplete="off" spellcheck="false" role="combobox" aria-expanded="true" aria-controls="search-results" />
          <kbd>Esc</kbd>
        </div>
        <ul class="search-results" id="search-results" role="listbox" data-search-results></ul>
        <p class="search-hint">{t(lang, 'search.hint')}</p>
      </div>
    </dialog>

    <script>
      import { initSearch } from '../lib/search';

      const root = document.documentElement;

      // Theme: system by default; the toggle pins the opposite of what is currently shown.
      document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
        const dark =
          root.dataset.theme === 'dark' ||
          (!root.dataset.theme && matchMedia('(prefers-color-scheme: dark)').matches);
        const next = dark ? 'light' : 'dark';
        root.dataset.theme = next;
        try {
          localStorage.setItem('theme', next);
        } catch {}
      });

      // Mobile menu
      const menuBtn = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
      const menu = document.getElementById('mobile-menu');
      menuBtn?.addEventListener('click', () => {
        const open = menuBtn.getAttribute('aria-expanded') !== 'true';
        menuBtn.setAttribute('aria-expanded', String(open));
        if (menu) menu.hidden = !open;
      });

      // Border under the nav only once the page has scrolled.
      const nav = document.querySelector('[data-nav]');
      const onScroll = () => nav?.classList.toggle('scrolled', scrollY > 4);
      addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      if (!/Mac|iPhone|iPad/.test(navigator.platform)) {
        document.querySelectorAll('[data-mod-key]').forEach((el) => (el.textContent = 'Ctrl K'));
      }

      initSearch();

      // One-time English gateway for browsers with no Japanese in their language list.
      const gate = document.querySelector<HTMLDialogElement>('[data-gate]');
      const dismissGate = () => {
        try {
          localStorage.setItem('gbf-gate', '1');
        } catch {}
        gate?.close();
      };
      let seen = false;
      try {
        seen = localStorage.getItem('gbf-gate') === '1';
      } catch {}
      const prefersJapanese = (navigator.languages ?? [navigator.language]).some((l) => /^ja\b/i.test(l));
      if (gate && !seen && !prefersJapanese && !/bot|crawl|spider|headless/i.test(navigator.userAgent)) {
        gate.showModal();
      }
      gate?.querySelector('[data-gate-enter]')?.addEventListener('click', dismissGate);
      gate?.addEventListener('cancel', dismissGate);
    </script>

    <style>
      .skip {
        position: absolute;
        left: -9999px;
      }
      .skip:focus {
        left: var(--s-4);
        top: var(--s-2);
        z-index: 100;
        padding: var(--s-2) var(--s-3);
        background: var(--bg);
      }

      .nav {
        position: sticky;
        top: 0;
        z-index: 50;
        background: color-mix(in srgb, var(--bg) 85%, transparent);
        backdrop-filter: saturate(180%) blur(12px);
        -webkit-backdrop-filter: saturate(180%) blur(12px);
        border-bottom: 1px solid transparent;
        transition: border-color var(--dur) var(--ease);
      }
      .nav.scrolled {
        border-bottom-color: var(--border);
      }
      .nav-inner {
        display: flex;
        align-items: center;
        gap: var(--s-6);
        height: var(--nav-h);
      }

      /* One-line hand-drawn logo, masked so it follows the text color. */
      .nav-logo {
        flex-shrink: 0;
        width: 170px;
        aspect-ratio: 1200 / 187;
        background: var(--fg);
        -webkit-mask: url('/logo-inline.png') center / contain no-repeat;
        mask: url('/logo-inline.png') center / contain no-repeat;
        transition: opacity var(--dur) var(--ease);
      }
      .nav-logo:hover {
        opacity: 0.75;
      }

      .wordmark {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        color: var(--fg);
        font-weight: 600;
        font-size: 15px;
        letter-spacing: -0.01em;
        text-decoration: none;
      }

      .nav-links {
        display: flex;
        gap: var(--s-1);
      }
      .nav-links a {
        padding: 6px var(--s-3);
        border-radius: var(--r-pill);
        color: var(--fg-muted);
        font-size: 14px;
        text-decoration: none;
        transition: color var(--dur) var(--ease), background-color var(--dur) var(--ease);
      }
      .nav-links a:hover {
        color: var(--fg);
      }
      .nav-links a[aria-current='page'] {
        color: var(--fg);
        background: var(--bg-subtle);
      }

      .nav-actions {
        display: flex;
        align-items: center;
        gap: var(--s-1);
        margin-left: auto;
      }
      .search-trigger {
        display: inline-flex;
        align-items: center;
        gap: var(--s-2);
        height: 34px;
        width: 220px;
        padding: 0 6px 0 var(--s-3);
        border: 1px solid var(--border);
        border-radius: var(--r-pill);
        background: var(--bg-subtle);
        color: var(--fg-subtle);
        font-size: 13px;
        transition: border-color var(--dur) var(--ease);
      }
      .search-trigger:hover {
        border-color: var(--border-strong);
      }
      .search-trigger kbd {
        margin-left: auto;
      }
      .icon-btn {
        display: inline-grid;
        place-items: center;
        width: 36px;
        height: 36px;
        border-radius: var(--r-pill);
        color: var(--fg-muted);
        transition: color var(--dur) var(--ease), background-color var(--dur) var(--ease);
      }
      .icon-btn:hover {
        color: var(--fg);
        background: var(--bg-hover);
      }
      .moon {
        display: none;
      }
      :global(:root[data-theme='dark']) .sun {
        display: none;
      }
      :global(:root[data-theme='dark']) .moon {
        display: block;
      }
      @media (prefers-color-scheme: dark) {
        :global(:root:not([data-theme='light'])) .sun {
          display: none;
        }
        :global(:root:not([data-theme='light'])) .moon {
          display: block;
        }
      }
      .lang-link {
        display: inline-grid;
        place-items: center;
        width: 36px;
        height: 36px;
        border-radius: var(--r-pill);
        color: var(--fg-muted);
        font-size: 12px;
        font-weight: 600;
        text-decoration: none;
      }
      .lang-link:hover {
        color: var(--fg);
        background: var(--bg-hover);
      }
      .menu-btn {
        display: none;
      }
      .mobile-menu nav {
        display: grid;
        padding-block: var(--s-2) var(--s-5);
      }
      .mobile-menu a {
        padding: var(--s-3) 0;
        border-bottom: 1px solid var(--border);
        color: var(--fg);
        font-size: 17px;
        text-decoration: none;
      }

      @media (max-width: 900px) {
        .nav-links {
          display: none;
        }
        .menu-btn {
          display: inline-grid;
        }
        .lang-link {
          display: none;
        }
        .search-trigger {
          width: 36px;
          padding: 0;
          justify-content: center;
          background: none;
          border-color: transparent;
          color: var(--fg-muted);
        }
        .search-trigger-label,
        .search-trigger kbd {
          display: none;
        }
      }

      main {
        min-height: 70vh;
      }

      .footer {
        margin-top: var(--s-10);
        border-top: 1px solid var(--border);
        padding-block: var(--s-7) var(--s-8);
        font-size: 14px;
      }
      .footer-inner {
        display: flex;
        justify-content: space-between;
        gap: var(--s-7);
        flex-wrap: wrap;
      }
      .footer-brand {
        max-width: 360px;
      }
      .footer-brand p {
        margin-top: var(--s-3);
        color: var(--fg-muted);
        font-size: 13px;
        line-height: 1.6;
      }
      .footer-cols {
        display: flex;
        gap: var(--s-8);
      }
      .footer h2 {
        margin-bottom: var(--s-3);
        color: var(--fg-subtle);
        font-size: 12px;
        font-weight: 500;
      }
      .footer ul {
        display: grid;
        gap: var(--s-2);
        padding: 0;
        list-style: none;
      }
      .footer ul a {
        color: var(--fg-muted);
        text-decoration: none;
      }
      .footer ul a:hover {
        color: var(--fg);
      }

      .gate-dialog {
        width: min(560px, calc(100vw - 32px));
        max-height: calc(100vh - 48px);
        margin: auto;
        padding: var(--s-7) var(--s-6);
        border: 1px solid var(--border);
        border-radius: var(--r-lg);
        background: var(--bg);
        color: var(--fg);
        box-shadow: 0 24px 64px rgb(0 0 0 / 0.18);
      }
      .gate-dialog::backdrop {
        background: rgb(0 0 0 / 0.45);
        backdrop-filter: blur(4px);
      }

      .search {
        width: min(640px, calc(100vw - 32px));
        max-height: min(560px, calc(100vh - 120px));
        margin: 12vh auto auto;
        padding: 0;
        border: 1px solid var(--border);
        border-radius: var(--r-lg);
        background: var(--bg);
        color: var(--fg);
        box-shadow: 0 24px 64px rgb(0 0 0 / 0.18);
      }
      .search::backdrop {
        background: rgb(0 0 0 / 0.35);
        backdrop-filter: blur(2px);
      }
      .search-panel {
        display: flex;
        flex-direction: column;
        max-height: inherit;
      }
      .search-field {
        display: flex;
        align-items: center;
        gap: var(--s-3);
        padding: 0 var(--s-4);
        height: 56px;
        border-bottom: 1px solid var(--border);
        color: var(--fg-subtle);
      }
      .search-field input {
        flex: 1;
        height: 100%;
        border: 0;
        outline: 0;
        background: none;
        color: var(--fg);
        font: inherit;
        font-size: 16px;
      }
      .search-field input::-webkit-search-cancel-button {
        display: none;
      }
      .search-results {
        flex: 1;
        overflow-y: auto;
        padding: var(--s-2);
        list-style: none;
      }
      .search-results:empty {
        display: none;
      }
      .search-results :global(a) {
        display: grid;
        gap: 2px;
        padding: var(--s-3);
        border-radius: var(--r-md);
        color: var(--fg);
        text-decoration: none;
      }
      .search-results :global([aria-selected='true'] a) {
        background: var(--bg-hover);
      }
      .search-results :global(.r-meta) {
        color: var(--fg-subtle);
        font-size: 12px;
      }
      .search-results :global(.r-title) {
        font-size: 15px;
        font-weight: 500;
        line-height: 1.4;
      }
      .search-results :global(.r-summary) {
        color: var(--fg-muted);
        font-size: 13px;
        line-height: 1.5;
        display: -webkit-box;
        -webkit-line-clamp: 1;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }
      .search-results :global(.r-empty) {
        padding: var(--s-6) var(--s-3);
        color: var(--fg-muted);
        text-align: center;
        font-size: 14px;
      }
      .search-hint {
        padding: var(--s-2) var(--s-4);
        border-top: 1px solid var(--border);
        color: var(--fg-subtle);
        font-size: 12px;
      }
      @media (max-width: 640px) {
        .search {
          margin-top: var(--s-4);
        }
        .search-hint {
          display: none;
        }
      }
    </style>
  </body>
</html>
