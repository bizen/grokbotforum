---
import type { Language } from '../utils/i18n';
import { t, getLocalizedPath, getAlternateLanguage } from '../utils/i18n';

interface Props {
  title: string;
  description?: string;
  lang: Language;
  alternateUrl?: string;
  ogType?: 'website' | 'article';
}

const { title, description, lang, alternateUrl, ogType = 'website' } = Astro.props;
const siteTitle = t(lang, 'site.title');
const fullTitle = title ? `${title} - ${siteTitle}` : siteTitle;
const siteDescription = description || t(lang, 'site.description');
const currentUrl = new URL(Astro.url.pathname, Astro.site);
const alternateLang = getAlternateLanguage(lang);
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={siteDescription} />
    
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={siteDescription} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={currentUrl} />
    <meta property="og:site_name" content={siteTitle} />
    
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={siteDescription} />
    
    {alternateUrl && (
      <>
        <link rel="alternate" hreflang={alternateLang} href={new URL(alternateUrl, Astro.site).href} />
        <link rel="alternate" hreflang={lang} href={currentUrl.href} />
      </>
    )}
    
    <link rel="alternate" type="application/rss+xml" title={`${siteTitle} RSS (${lang})`} href={`${Astro.site}${getLocalizedPath('/feed.xml', lang)}`} />
    
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <style is:global>
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }
      
      :root {
        --color-text: #1d1d1f;
        --color-text-secondary: #6e6e73;
        --color-bg: #ffffff;
        --color-bg-alt: #f5f5f7;
        --color-border: rgba(0, 0, 0, 0.08);
        --color-card-bg: #ffffff;
        --color-accent: #0071e3;
        --color-accent-hover: #0077ed;
        --font-sans-ja: -apple-system, BlinkMacSystemFont, "Hiragino Sans", "Hiragino Kaku Gothic ProN", "Noto Sans JP", "Yu Gothic UI", Meiryo, "Segoe UI", Roboto, sans-serif;
        --font-sans-en: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Helvetica Neue", "Segoe UI", Roboto, Arial, sans-serif;
        --font-mono: ui-monospace, "SF Mono", Monaco, "Cascadia Code", "Roboto Mono", Consolas, monospace;
        --content-width: 980px;
        --reading-width: 680px;
        --nav-height: 44px;
        --transition-speed: 0.3s;
        --grid-unit: 8px;
      }
      
      @media (prefers-color-scheme: dark) {
        :root {
          --color-text: #f5f5f7;
          --color-text-secondary: #a1a1a6;
          --color-bg: #000000;
          --color-bg-alt: #1d1d1f;
          --color-border: rgba(255, 255, 255, 0.08);
          --color-card-bg: #1d1d1f;
          --color-accent: #2997ff;
          --color-accent-hover: #409cff;
        }
      }
      
      html {
        scroll-behavior: smooth;
      }
      
      body {
        color: var(--color-text);
        background: var(--color-bg);
        font-size: 17px;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        transition: background-color var(--transition-speed) ease, color var(--transition-speed) ease;
      }
      
      body[lang="ja"],
      body[lang="ja"] * {
        font-family: var(--font-sans-ja);
        line-height: 1.75;
      }
      
      body[lang="en"],
      body[lang="en"] * {
        font-family: var(--font-sans-en);
        line-height: 1.47059;
      }
      
      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
          scroll-behavior: auto !important;
        }
      }
      
      a {
        color: var(--color-accent);
        text-decoration: none;
        transition: opacity var(--transition-speed) ease;
        min-height: 44px;
        min-width: 44px;
        display: inline-flex;
        align-items: center;
      }
      
      a:hover {
        text-decoration: underline;
        opacity: 0.8;
      }
      
      a:focus-visible {
        outline: 2px solid var(--color-accent);
        outline-offset: 2px;
        border-radius: 4px;
      }
      
      h1, h2, h3, h4, h5, h6 {
        font-weight: 600;
        margin-bottom: calc(var(--grid-unit) * 2);
      }
      
      h1 {
        font-size: clamp(40px, 6vw, 64px);
        font-weight: 700;
        line-height: 1.0625;
        margin-bottom: calc(var(--grid-unit) * 3);
      }
      
      body[lang="ja"] h1,
      body[lang="ja"] h2,
      body[lang="ja"] h3 {
        letter-spacing: 0;
        font-feature-settings: "palt";
        word-break: auto-phrase;
        overflow-wrap: anywhere;
      }
      
      body[lang="en"] h1 {
        letter-spacing: -0.028em;
      }
      
      body[lang="en"] h2 {
        letter-spacing: -0.022em;
      }
      
      h2 {
        font-size: clamp(32px, 4vw, 48px);
        font-weight: 600;
        line-height: 1.0834933333;
      }
      
      h3 {
        font-size: clamp(24px, 3vw, 32px);
        line-height: 1.1428571429;
      }
      
      p {
        margin-bottom: calc(var(--grid-unit) * 2);
      }
      
      ul, ol {
        margin-bottom: calc(var(--grid-unit) * 2);
        padding-left: calc(var(--grid-unit) * 3);
      }
      
      code {
        font-family: var(--font-mono);
        font-size: 0.94em;
        background: var(--color-bg-alt);
        padding: 0.2em 0.4em;
        border-radius: 6px;
      }
      
      pre {
        overflow-x: auto;
        margin-bottom: calc(var(--grid-unit) * 2);
        padding: calc(var(--grid-unit) * 3);
        background: var(--color-bg-alt);
        border-radius: 18px;
        border: 1px solid var(--color-border);
      }
      
      pre code {
        background: none;
        padding: 0;
      }
      
      @media (max-width: 768px) {
        body {
          font-size: 17px;
        }
      }
    </style>
  </head>
  <body lang={lang}>
    <header>
      <div class="container">
        <div class="header-content">
          <h1 class="site-title">
            <a href={getLocalizedPath('/', lang)}>{siteTitle}</a>
          </h1>
          <nav>
            <a href={getLocalizedPath('/', lang)}>{t(lang, 'nav.home')}</a>
            <a href={getLocalizedPath('/bots/', lang)}>{t(lang, 'nav.bots')}</a>
            <a href={getLocalizedPath('/templates/', lang)}>{t(lang, 'nav.templates')}</a>
            <span class="separator" aria-hidden="true">|</span>
            <a href={alternateUrl || getLocalizedPath('/', alternateLang)} class="lang-toggle" lang={alternateLang}>
              {alternateLang === 'ja' ? '日本語' : 'English'}
            </a>
          </nav>
        </div>
      </div>
    </header>
    
    <main>
      <div class="container">
        <slot />
      </div>
    </main>
    
    <footer>
      <div class="container">
        <div class="footer-content">
          <p class="unofficial-notice">{lang === 'ja' ? '非公式ファンサイト' : 'Unofficial fan site'}</p>
          <p class="copyright">&copy; {new Date().getFullYear()} Grok Bot Forum</p>
        </div>
      </div>
    </footer>
    
    <style>
      header {
        position: sticky;
        top: 0;
        background: rgba(255, 255, 255, 0.72);
        backdrop-filter: saturate(180%) blur(20px);
        -webkit-backdrop-filter: saturate(180%) blur(20px);
        border-bottom: 1px solid var(--color-border);
        height: var(--nav-height);
        z-index: 9999;
        transition: background-color var(--transition-speed) ease;
      }
      
      @media (prefers-color-scheme: dark) {
        header {
          background: rgba(0, 0, 0, 0.72);
        }
      }
      
      @media (min-width: 1024px) {
        header {
          --nav-height: 52px;
        }
      }
      
      .container {
        max-width: var(--content-width);
        margin: 0 auto;
        padding: 0 max(env(safe-area-inset-right), calc(var(--grid-unit) * 3));
        padding-left: max(env(safe-area-inset-left), calc(var(--grid-unit) * 3));
      }
      
      .header-content {
        display: flex;
        justify-content: space-between;
        align-items: center;
        height: var(--nav-height);
        gap: calc(var(--grid-unit) * 3);
      }
      
      .site-title {
        font-size: 17px;
        margin: 0;
        font-weight: 600;
        letter-spacing: -0.022em;
        line-height: 1;
      }
      
      .site-title a {
        color: var(--color-text);
        text-decoration: none;
        min-height: var(--nav-height);
        display: flex;
        align-items: center;
      }
      
      nav {
        display: flex;
        gap: calc(var(--grid-unit) * 4);
        align-items: center;
        font-size: 14px;
      }
      
      nav a {
        white-space: nowrap;
        color: var(--color-text);
        text-decoration: none;
        min-height: var(--nav-height);
        display: flex;
        align-items: center;
        padding: 0 calc(var(--grid-unit) * 1);
        margin: 0 calc(var(--grid-unit) * -1);
      }
      
      nav a:hover {
        opacity: 0.6;
        text-decoration: none;
      }
      
      nav .separator {
        color: var(--color-text-secondary);
        user-select: none;
        opacity: 0.5;
      }
      
      nav .lang-toggle {
        font-weight: 400;
        color: var(--color-accent);
      }
      
      nav .lang-toggle:hover {
        text-decoration: underline;
      }
      
      main {
        min-height: calc(100vh - var(--nav-height) - 300px);
        padding-top: calc(var(--grid-unit) * 10);
        padding-bottom: calc(var(--grid-unit) * 17.5);
      }
      
      @media (min-width: 1024px) {
        main {
          padding-top: calc(var(--grid-unit) * 17.5);
        }
      }
      
      footer {
        border-top: 1px solid var(--color-border);
        padding: calc(var(--grid-unit) * 6) 0;
        background: var(--color-bg);
      }
      
      .footer-content {
        display: flex;
        justify-content: space-between;
        align-items: center;
        color: var(--color-text-secondary);
        font-size: 12px;
        gap: calc(var(--grid-unit) * 2);
        flex-wrap: wrap;
      }
      
      .unofficial-notice {
        opacity: 0.8;
      }
      
      .copyright {
        margin: 0;
      }
      
      @media (max-width: 734px) {
        .container {
          padding: 0 max(env(safe-area-inset-right), calc(var(--grid-unit) * 2));
          padding-left: max(env(safe-area-inset-left), calc(var(--grid-unit) * 2));
        }
        
        .header-content {
          gap: calc(var(--grid-unit) * 2);
        }
        
        nav {
          gap: calc(var(--grid-unit) * 2);
          font-size: 12px;
        }
        
        .site-title {
          font-size: 15px;
        }
        
        main {
          padding-top: calc(var(--grid-unit) * 6);
          padding-bottom: calc(var(--grid-unit) * 8);
        }
        
        .footer-content {
          flex-direction: column;
          align-items: flex-start;
          gap: calc(var(--grid-unit) * 1);
        }
      }
    </style>
  </body>
</html>
