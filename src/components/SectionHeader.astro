---
interface Props {
  title: string;
  description?: string;
  href?: string;
  linkLabel?: string;
}

const { title, description, href, linkLabel } = Astro.props;
---

<div class="head">
  <div>
    <h2>{title}</h2>
    {description && <p>{description}</p>}
  </div>
  {href && (
    <a href={href}>
      {linkLabel}
      <span aria-hidden="true">→</span>
    </a>
  )}
</div>

<style>
  .head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: var(--s-4);
    margin-bottom: var(--s-4);
  }
  h2 {
    font-size: 22px;
  }
  p {
    margin-top: var(--s-1);
    color: var(--fg-muted);
    font-size: 15px;
  }
  a {
    display: inline-flex;
    gap: var(--s-1);
    flex-shrink: 0;
    color: var(--fg-muted);
    font-size: 14px;
    text-decoration: none;
  }
  a:hover {
    color: var(--fg);
  }
</style>
