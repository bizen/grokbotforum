---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StatusBox from '../StatusBox.astro';
import { OFFICIAL_DOCS, OFFICIAL_DOCS_BASE } from '../../data/official-docs';
import { OFFICIAL_LINKS, SHORTCUTS } from '../../data/official-links';
import { QUICK_FACTS, QUICK_FACTS_CHECKED } from '../../data/quick-facts';
import {
  COLLECTION_META,
  getAllItems,
  getItems,
  getNavCollections,
  isNew,
  itemDate,
  itemPath,
  splitId,
  type Item,
} from '../../lib/content';
import { localizedPath, t } from '../../lib/i18n';

// Dense, Yahoo! JAPAN–style portal: scan-first layout, same quiet visual system.
const lang = 'ja';

const navCollections = await getNavCollections(lang);
// Glossary terms are reference entries, not updates, so they stay out of the 新着 feed.
// Recent news leads: guides and bots are often re-checked in bulk, and their shared
// updated date would otherwise push every headline off the list.
const byDate = (a: Item, b: Item) => itemDate(b).getTime() - itemDate(a).getTime();
const updates = (await getAllItems(lang)).filter((item) => item.collection !== 'glossary').sort(byDate);
const freshNews = updates.filter((item) => item.collection === 'news' && isNew(item));
const latest = [...freshNews, ...updates.filter((item) => !freshNews.includes(item))];
const tabs = [
  { id: 'top', label: '新着', items: latest.slice(0, 8), more: null as string | null },
  ...(await Promise.all(
    navCollections.map(async (c) => ({
      id: c,
      label: COLLECTION_META[c][lang].label,
      items: (await getItems(c, lang)).slice(0, 8),
      more: localizedPath(`/${c}/`, lang),
    })),
  )),
];

const docSlugs = new Set((await getItems('docs', lang)).map((item) => splitId(item.id).slug));
// Marketplace highlights: the featured row and Grok Bot Team picks first.
const bots = (await getItems('bots', lang))
  .filter((item) => item.collection === 'bots' && (item.data.featured || item.data.team))
  .slice(0, 6) as Extract<Item, { collection: 'bots' }>[];

const builtAt = new Intl.DateTimeFormat('ja-JP', {
  month: 'numeric',
  day: 'numeric',
  weekday: 'short',
  hour: 'numeric',
  minute: '2-digit',
  timeZone: 'Asia/Tokyo',
})
  .formatToParts(new Date())
  .reduce<Record<string, string>>((acc, p) => ({ ...acc, [p.type]: p.value }), {});
const updatedLabel = `${builtAt.month}/${builtAt.day}(${builtAt.weekday}) ${builtAt.hour}:${builtAt.minute}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Grok Bot Forum',
  url: new URL('/', Astro.site).href,
  inLanguage: lang,
  description: t(lang, 'site.description'),
};
---

<BaseLayout lang={lang} jsonPath="/index.json" jsonLd={jsonLd}>
  <div class="portal container">
    <section class="searchband" aria-label={t(lang, 'nav.search')}>
      <div class="masthead">
        {(['left', 'right'] as const).map((side) => (
          <ul class:list={['shortcuts', side]} aria-label="関連サービス">
            {SHORTCUTS.filter((s) => s.side === side).map((s) => (
              <li>
                <a href={s.url} rel="noopener" title={s.label}>
                  {s.icon === 'bot' ? (
                    <svg viewBox="0 0 64 64" aria-hidden="true">
                      <circle cx="32" cy="32" r="30" fill="currentColor" />
                      <rect class="bot-eye" x="26" y="15" width="8" height="18" rx="4" transform="rotate(-30 30 24)" />
                      <rect class="bot-eye" x="40" y="12" width="8" height="18" rx="4" transform="rotate(-30 44 21)" />
                    </svg>
                  ) : (
                    <svg viewBox={s.icon.viewBox} aria-hidden="true">
                      {s.icon.paths.map((d) => <path d={d} fill="currentColor" />)}
                    </svg>
                  )}
                  <span class="visually-hidden">{s.label}</span>
                </a>
              </li>
            ))}
          </ul>
        ))}
        <h1 class="logo">
          <span class="logo-ink" aria-hidden="true"></span>
          <span class="visually-hidden">Grok Bot Forum</span>
        </h1>
      </div>
      <div class="scopes">
        <button type="button" class="scope current" data-search-open>すべて</button>
        {navCollections.map((c) => (
          <button type="button" class="scope" data-search-open data-search-scope={c}>
            {COLLECTION_META[c][lang].label}
          </button>
        ))}
      </div>
      <button type="button" class="searchbox" data-search-open>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
          <circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" stroke-linecap="round" />
        </svg>
        <span>{t(lang, 'home.searchPlaceholder')}</span>
        <kbd data-mod-key>⌘K</kbd>
      </button>
      <ul class="ticker">
        {latest.slice(0, 2).map((item) => (
          <li>
            <span class="ticker-label">{t(lang, 'portal.latest')}</span>
            <a href={itemPath(item)}>{item.data.title}</a>
          </li>
        ))}
      </ul>
    </section>

    <div class="grid">
      <div class="center">
        <section class="box topics">
          <div class="tabs" role="tablist" aria-label="トピック">
            {tabs.map((tab, i) => (
              <button type="button" role="tab" id={`tab-${tab.id}`} aria-controls={`panel-${tab.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
                {tab.label}
              </button>
            ))}
          </div>
          {tabs.map((tab, i) => (
            <div class="panel" role="tabpanel" id={`panel-${tab.id}`} aria-labelledby={`tab-${tab.id}`} hidden={i !== 0}>
              <p class="stamp tabular">{updatedLabel}{t(lang, 'portal.updated')}</p>
              <ul class="headlines">
                {tab.items.map((item) => (
                  <li>
                    <a href={itemPath(item)}>{item.data.title}</a>
                    {isNew(item) && <span class="new">NEW</span>}
                    {tab.id === 'top' && <span class="kind">{COLLECTION_META[item.collection][lang].label}</span>}
                    {item.data.sources.length > 0 && (
                      <span class="count tabular" title={t(lang, 'common.sources')}>
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1" stroke-linecap="round" /></svg>
                        {item.data.sources.length}
                      </span>
                    )}
                  </li>
                ))}
              </ul>
              {tab.more && <a class="more" href={tab.more}>{t(lang, 'portal.more')}</a>}
            </div>
          ))}
        </section>

        {bots.length > 0 && (
          <section class="box">
            <h2 class="box-title">
              {t(lang, 'portal.marketplace')}
              <a href={localizedPath('/bots/', lang)}>{t(lang, 'common.viewAll')}</a>
            </h2>
            <ul class="messages">
              {bots.map((item) => (
                <li>
                  <a href={itemPath(item)}>
                    <span class="m-title">{item.data.title}</span>
                    <span class="m-by">{item.data.creator}</span>
                    <span class="m-line">{item.data.summary}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}
      </div>

      <div class="leftcol">
      <nav class="box links" aria-label="公式リンク">
        <h2 class="box-title">公式リンク</h2>
        {OFFICIAL_LINKS.map((group) => (
          <div class="toc-group">
            <h3>{group.group}</h3>
            <ul>
              {group.links.map((link) => (
                <li>
                  <a class="external" href={link.url} rel="noopener">
                    {link.label}<span aria-hidden="true"> ↗</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </nav>

      <nav class="box toc" aria-label={t(lang, 'portal.officialToc')}>
        <h2 class="box-title">{t(lang, 'portal.officialToc')}</h2>
        {OFFICIAL_DOCS.map((group) => (
          <div class="toc-group">
            <h3>{group.group}</h3>
            <ul>
              {group.pages.map((page) =>
                docSlugs.has(page.slug) ? (
                  <li><a href={localizedPath(`/docs/${page.slug}/`, lang)}>{page.title}</a></li>
                ) : (
                  <li><a class="external" href={OFFICIAL_DOCS_BASE + page.slug} rel="noopener" hreflang="en">{page.title}<span aria-hidden="true"> ↗</span></a></li>
                ),
              )}
            </ul>
          </div>
        ))}
        {OFFICIAL_DOCS.some((g) => g.pages.some((p) => !docSlugs.has(p.slug))) && (
          <p class="note">{t(lang, 'portal.officialTocNote')}</p>
        )}
      </nav>
      </div>

      <aside class="side">
        <StatusBox />
        <section class="box">
          <h2 class="box-title">{t(lang, 'portal.facts')}</h2>
          <dl class="facts">
            {QUICK_FACTS.map((fact) => (
              <div>
                <dt>{fact.label}</dt>
                <dd><a href={fact.source} rel="noopener">{fact.value}</a></dd>
              </div>
            ))}
          </dl>
          <p class="note tabular">{t(lang, 'portal.checked')} {QUICK_FACTS_CHECKED}</p>
        </section>

        <section class="box">
          <h2 class="box-title">
            {t(lang, 'home.agents.title')}
            <a href={localizedPath('/agents/', lang)}>{t(lang, 'portal.more')}</a>
          </h2>
          <p class="agents-lede">{t(lang, 'home.agents.lede')}</p>
          <ul class="endpoints">
            <li><a href={localizedPath('/agents/', lang)}><code>/mcp</code></a><span>MCP サーバー</span></li>
            <li><a href="/llms.txt"><code>/llms.txt</code></a></li>
            <li><a href="/llms-full.txt"><code>/llms-full.txt</code></a></li>
            <li><a href="/index.json"><code>/index.json</code></a></li>
          </ul>
        </section>
      </aside>
    </div>
  </div>
</BaseLayout>

<script>
  const tablist = document.querySelector<HTMLElement>('.topics [role="tablist"]');
  const tabs = [...(tablist?.querySelectorAll<HTMLButtonElement>('[role="tab"]') ?? [])];
  const select = (tab: HTMLButtonElement) => {
    for (const t of tabs) {
      const on = t === tab;
      t.setAttribute('aria-selected', String(on));
      t.tabIndex = on ? 0 : -1;
      const panel = document.getElementById(t.getAttribute('aria-controls') ?? '');
      if (panel) panel.hidden = !on;
    }
  };
  tabs.forEach((tab, i) => {
    tab.addEventListener('click', () => select(tab));
    tab.addEventListener('keydown', (event) => {
      const step = event.key === 'ArrowRight' ? 1 : event.key === 'ArrowLeft' ? -1 : 0;
      if (!step) return;
      const next = tabs[(i + step + tabs.length) % tabs.length];
      select(next);
      next.focus();
    });
  });
</script>

<style>
  .portal {
    max-width: calc(1120px + var(--gutter) * 2);
  }

  /* Search band */
  .searchband {
    display: grid;
    justify-items: center;
    gap: var(--s-2);
    padding: var(--s-2) 0 var(--s-4);
  }
  /* Logo flanked by shortcuts to the services this hub is about. */
  .masthead {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    grid-template-areas: 'left logo right';
    align-items: center;
    gap: var(--s-6);
    width: 100%;
  }
  .masthead .logo {
    grid-area: logo;
  }
  .shortcuts {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    padding: 0;
    list-style: none;
  }
  .shortcuts.left {
    grid-area: left;
    align-items: flex-end;
  }
  .shortcuts.right {
    grid-area: right;
    align-items: flex-start;
  }
  .shortcuts a {
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    border-radius: var(--r-md);
    color: var(--fg);
    transition: background-color var(--dur) var(--ease);
  }
  .shortcuts a:hover {
    background: var(--bg-hover);
  }
  .shortcuts svg {
    width: 40px;
    height: 40px;
  }
  .bot-eye {
    fill: var(--bg);
  }
  /* Hand-drawn logo, used as a mask so it takes the text color in both themes.
     Cyberpunk glitch: cyan/magenta copies split off in short bursts; the ink itself stays monochrome. */
  .logo {
    --logo-mask: url('/logo.png') center / contain no-repeat;
    --cyan: #00e5ff;
    --magenta: #ff2bd6;
    position: relative;
    width: clamp(220px, 28vw, 340px);
    aspect-ratio: 1000 / 318;
  }
  .logo-ink,
  .logo::before,
  .logo::after {
    position: absolute;
    inset: 0;
    -webkit-mask: var(--logo-mask);
    mask: var(--logo-mask);
  }
  .logo-ink {
    z-index: 1;
    background: var(--fg);
  }
  .logo::before,
  .logo::after {
    content: '';
    opacity: 0;
    mix-blend-mode: multiply;
    pointer-events: none;
  }
  .logo::before {
    background: var(--cyan);
  }
  .logo::after {
    background: var(--magenta);
  }
  :global(:root[data-theme='dark']) .logo::before,
  :global(:root[data-theme='dark']) .logo::after {
    mix-blend-mode: screen;
  }
  :global(:root[data-theme='dark']) .logo-ink {
    filter: drop-shadow(0 0 6px rgb(0 229 255 / 0.35)) drop-shadow(0 0 18px rgb(255 43 214 / 0.18));
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .logo::before,
    :global(:root:not([data-theme='light'])) .logo::after {
      mix-blend-mode: screen;
    }
    :global(:root:not([data-theme='light'])) .logo-ink {
      filter: drop-shadow(0 0 6px rgb(0 229 255 / 0.35)) drop-shadow(0 0 18px rgb(255 43 214 / 0.18));
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .logo-ink {
      animation: glitch-ink 5s steps(1, end) infinite;
    }
    .logo::before {
      z-index: 2;
      animation: glitch-cyan 5s steps(1, end) infinite;
    }
    .logo::after {
      z-index: 0;
      animation: glitch-magenta 5s steps(1, end) infinite;
    }
    .logo:hover .logo-ink,
    .logo:hover::before,
    .logo:hover::after {
      animation-duration: 0.9s;
    }
  }

  /* Quiet for most of the cycle, then a ~0.4s burst of slices and RGB split. */
  @keyframes glitch-ink {
    0%, 90%, 100% { transform: none; clip-path: none; }
    91% { transform: translate(-3px, 0); clip-path: inset(0 0 55% 0); }
    92% { transform: translate(4px, 0); clip-path: inset(40% 0 20% 0); }
    93% { transform: translate(-2px, 1px); clip-path: inset(70% 0 0 0); }
    94% { transform: translate(2px, -1px); clip-path: none; }
    96% { transform: translate(-1px, 0); clip-path: inset(20% 0 60% 0); }
    97% { transform: none; clip-path: none; }
  }
  @keyframes glitch-cyan {
    0%, 90%, 98%, 100% { opacity: 0; transform: none; clip-path: none; }
    91% { opacity: 0.9; transform: translate(-6px, -1px); clip-path: inset(10% 0 50% 0); }
    92% { opacity: 0.9; transform: translate(5px, 0); clip-path: inset(55% 0 10% 0); }
    93% { opacity: 0.8; transform: translate(-4px, 1px); clip-path: inset(0 0 70% 0); }
    94% { opacity: 0.7; transform: translate(-3px, 0); clip-path: none; }
    96% { opacity: 0.9; transform: translate(7px, 0); clip-path: inset(30% 0 45% 0); }
  }
  @keyframes glitch-magenta {
    0%, 90%, 98%, 100% { opacity: 0; transform: none; clip-path: none; }
    91% { opacity: 0.9; transform: translate(6px, 1px); clip-path: inset(45% 0 15% 0); }
    92% { opacity: 0.9; transform: translate(-5px, 0); clip-path: inset(5% 0 65% 0); }
    93% { opacity: 0.8; transform: translate(4px, -1px); clip-path: inset(60% 0 0 0); }
    94% { opacity: 0.7; transform: translate(3px, 0); clip-path: none; }
    96% { opacity: 0.9; transform: translate(-7px, 0); clip-path: inset(15% 0 65% 0); }
  }
  .scopes {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--s-1);
  }
  .scope {
    padding: 2px var(--s-2);
    border-radius: var(--r-sm);
    color: var(--fg-muted);
    font-size: 14px;
  }
  .scope:hover {
    color: var(--fg);
    background: var(--bg-hover);
  }
  .scope.current {
    color: var(--fg);
    font-weight: 600;
  }
  .searchbox {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    width: min(640px, 100%);
    height: 50px;
    padding: 0 var(--s-3) 0 var(--s-4);
    border: 1px solid var(--border-strong);
    border-radius: var(--r-md);
    background: var(--bg);
    color: var(--fg-subtle);
    font-size: 15px;
    text-align: left;
    transition: border-color var(--dur) var(--ease);
  }
  .searchbox:hover {
    border-color: var(--fg-subtle);
  }
  .searchbox span {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .ticker {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--s-1) var(--s-6);
    padding: 0;
    list-style: none;
    font-size: 14px;
  }
  .ticker li {
    display: flex;
    gap: var(--s-2);
    min-width: 0;
  }
  .ticker-label {
    color: var(--fg-subtle);
  }
  .ticker-label::before {
    content: '» ';
  }
  .ticker a {
    text-decoration: none;
  }
  .ticker a:hover {
    text-decoration: underline;
  }

  /* Three columns */
  .grid {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr) 280px;
    grid-template-areas: 'toc center side';
    gap: var(--s-4);
    align-items: start;
  }
  .leftcol {
    grid-area: toc;
    display: grid;
    gap: var(--s-4);
    align-content: start;
  }
  .center {
    grid-area: center;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--s-4);
  }
  .side {
    grid-area: side;
    display: grid;
    gap: var(--s-4);
  }

  .note {
    margin-top: var(--s-3);
    color: var(--fg-subtle);
    font-size: 11.5px;
  }

  /* Topics */
  .topics {
    padding: 0;
  }
  .tabs {
    display: flex;
    overflow-x: auto;
    border-bottom: 1px solid var(--border);
    scrollbar-width: none;
  }
  .tabs button {
    flex-shrink: 0;
    padding: var(--s-3) var(--s-4);
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    color: var(--fg-muted);
    font-size: 14px;
  }
  .tabs button:hover {
    color: var(--fg);
  }
  .tabs button[aria-selected='true'] {
    border-bottom-color: var(--fg);
    color: var(--fg);
    font-weight: 600;
  }
  .panel {
    padding: var(--s-3) var(--s-4) var(--s-4);
  }
  .stamp {
    color: var(--fg-subtle);
    font-size: 12px;
  }
  .headlines {
    margin-top: var(--s-2);
    padding: 0;
    list-style: none;
  }
  .headlines li {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    padding: 7px 0;
    font-size: 15px;
    line-height: 1.5;
  }
  .headlines li::before {
    content: '';
    flex-shrink: 0;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--fg-subtle);
  }
  .headlines a {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    text-decoration: none;
  }
  .headlines a:hover {
    text-decoration: underline;
  }
  .new {
    flex-shrink: 0;
    padding: 1px 6px;
    border-radius: 4px;
    background: var(--inverse-bg);
    color: var(--inverse-fg);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.04em;
    line-height: 1.5;
  }
  .kind {
    flex-shrink: 0;
    color: var(--fg-subtle);
    font-size: 12px;
  }
  .count {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    gap: 3px;
    color: var(--fg-subtle);
    font-size: 12px;
  }
  .more {
    display: inline-block;
    margin-top: var(--s-2);
    color: var(--fg-muted);
    font-size: 13px;
  }

  /* First messages */
  .messages {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-2);
    padding: 0;
    list-style: none;
  }
  .messages a {
    display: grid;
    gap: 2px;
    height: 100%;
    padding: var(--s-3);
    border-radius: var(--r-sm);
    background: var(--bg-subtle);
    text-decoration: none;
    transition: background-color var(--dur) var(--ease);
  }
  .messages a:hover {
    background: var(--bg-hover);
  }
  .m-title {
    font-size: 14px;
    font-weight: 500;
  }
  .m-by {
    color: var(--fg-subtle);
    font-size: 12px;
  }
  .m-line {
    display: -webkit-box;
    overflow: hidden;
    color: var(--fg-muted);
    font-size: 12.5px;
    line-height: 1.5;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  /* Official docs TOC */
  .links li a {
    font-size: 13.5px;
  }
  .toc-group + .toc-group {
    margin-top: var(--s-4);
  }
  :is(.toc, .links) h3 {
    margin-bottom: var(--s-1);
    color: var(--fg-subtle);
    font-size: 12px;
    font-weight: 500;
  }
  :is(.toc, .links) ul {
    padding: 0;
