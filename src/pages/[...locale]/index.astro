---
import HomeEn from '../../components/home/HomeEn.astro';
import HomeJa from '../../components/home/HomeJa.astro';
import { LANGS, localeParam, type Lang } from '../../lib/i18n';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { locale: localeParam(lang) }, props: { lang } }));
}

// Japanese readers expect a dense, scannable portal; English keeps the minimal search-first home.
const { lang } = Astro.props as { lang: Lang };
---

{lang === 'ja' ? <HomeJa /> : <HomeEn lang={lang} />}
