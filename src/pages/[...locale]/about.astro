---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { LANGS, localeParam, localizedPath, otherLang, t, type Lang } from '../../lib/i18n';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { locale: localeParam(lang) }, props: { lang } }));
}

const { lang } = Astro.props as { lang: Lang };

const copy = {
  ja: {
    lede: 'grokbotforum は、Grok と Grok bot に関する情報を集め、使える形に整理する非公式のナレッジベースです。',
    sections: [
      {
        h: '何をしているか',
        p: [
          'ガイド、ボット、プロンプト、ニュースの 4 種類のコンテンツを扱います。どれも要約、更新日、出典をつけ、古くなった情報は更新するか取り下げます。',
        ],
      },
      {
        h: '人間がアクセスしなくても役に立つように',
        p: [
          'すべてのページは JSON と llms.txt でも公開しています。ページの URL の末尾を .json に変えると、同じ内容を構造化データで取得できます。',
          '今後、このデータを使う MCP サーバーと Grok のカスタムボットを公開する予定です。',
        ],
      },
      {
        h: '非公式であること',
        p: ['このサイトは xAI および X Corp. とは関係ありません。Grok は xAI の商標です。公式情報は必ず一次情報源で確認してください。'],
      },
      {
        h: '参加する',
        p: ['誤りの報告や追加の提案は GitHub で受け付けています。'],
      },
    ],
  },
  en: {
    lede: 'grokbotforum is an unofficial knowledge base that collects information about Grok and Grok bots and packages it into something useful.',
    sections: [
      {
        h: 'What it does',
        p: [
          'It covers four kinds of content: guides, bots, prompts, and news. Every item has a summary, an updated date, and sources. Stale items are updated or removed.',
        ],
      },
      {
        h: 'Useful without a human in the loop',
        p: [
          'Every page is also published as JSON and through llms.txt. Replace the trailing slash of any page URL with .json to get the same content as structured data.',
          'An MCP server and a Grok custom bot built on this data are planned.',
        ],
      },
      {
        h: 'Unofficial',
        p: ['This site is not affiliated with xAI or X Corp. Grok is a trademark of xAI. Always confirm official details with primary sources.'],
      },
      {
        h: 'Contribute',
        p: ['Corrections and suggestions are welcome on GitHub.'],
      },
    ],
  },
}[lang];
---

<BaseLayout lang={lang} title={t(lang, 'nav.about')} description={copy.lede} alternatePath={localizedPath('/about/', otherLang(lang))}>
  <div class="container page reveal">
    <h1>{t(lang, 'nav.about')}</h1>
    <p class="lede">{copy.lede}</p>
    <div class="prose">
      {copy.sections.map((s) => (
        <>
          <h2>{s.h}</h2>
          {s.p.map((p) => <p>{p}</p>)}
        </>
      ))}
      <p><a href="https://github.com/bizen/grokbotforum">github.com/bizen/grokbotforum</a> · <a href="/llms.txt">/llms.txt</a> · <a href="/index.json">/index.json</a></p>
    </div>
  </div>
</BaseLayout>

<style>
  .page {
    max-width: calc(var(--w-content) + var(--gutter) * 2);
    padding-top: var(--s-9);
  }
  h1 {
    font-size: clamp(32px, 4vw, 48px);
  }
  .lede {
    margin: var(--s-4) 0 var(--s-6);
    color: var(--fg-muted);
    font-size: 18px;
  }
</style>
