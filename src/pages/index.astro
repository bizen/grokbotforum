---
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '../utils/i18n';
import { getCollection } from 'astro:content';

const lang = 'ja';
const articles = (await getCollection('articles'))
  .filter(article => article.data.language === lang)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout 
  title={t(lang, 'home.title')}
  lang={lang}
  alternateUrl="/en/"
>
  <h1 class="page-title">{t(lang, 'home.title')}</h1>
  
  {articles.length === 0 ? (
    <p class="empty-state">{t(lang, 'home.empty')}</p>
  ) : (
    <div class="article-grid">
      {articles.map(article => (
        <a href={`/articles/${article.slug}/`} class="article-card">
          <article>
            <time datetime={article.data.date.toISOString()}>
              {article.data.date.toLocaleDateString('ja-JP', { 
                year: 'numeric', 
                month: 'long', 
                day: 'numeric' 
              })}
            </time>
            <h2>{article.data.title}</h2>
            {article.data.description && (
              <p class="description">{article.data.description}</p>
            )}
          </article>
        </a>
      ))}
    </div>
  )}
</BaseLayout>

<style>
  .page-title {
    margin-bottom: calc(var(--grid-unit) * 8);
    font-size: clamp(40px, 6vw, 64px);
    font-weight: 700;
    line-height: 1.0625;
  }
  
  .empty-state {
    color: var(--color-text-secondary);
    text-align: center;
    padding: calc(var(--grid-unit) * 12) 0;
    font-size: 17px;
  }
  
  .article-grid {
    display: grid;
    gap: calc(var(--grid-unit) * 3);
    max-width: var(--reading-width);
  }
  
  .article-card {
    display: block;
    padding: calc(var(--grid-unit) * 4);
    background: var(--color-card-bg);
    border: 1px solid var(--color-border);
    border-radius: 28px;
    transition: all var(--transition-speed) ease;
    text-decoration: none;
    color: inherit;
    min-height: 44px;
  }
  
  .article-card:hover {
    border-color: var(--color-text-secondary);
    text-decoration: none;
    opacity: 1;
    transform: scale(1.005);
  }
  
  .article-card time {
    display: block;
    color: var(--color-text-secondary);
    font-size: 14px;
    margin-bottom: calc(var(--grid-unit) * 2);
    font-weight: 400;
    min-height: auto;
  }
  
  .article-card h2 {
    font-size: clamp(24px, 3vw, 32px);
    margin-bottom: calc(var(--grid-unit) * 2);
    font-weight: 600;
    line-height: 1.1428571429;
  }
  
  .description {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: 17px;
    line-height: inherit;
  }
  
  @media (max-width: 734px) {
    .page-title {
      margin-bottom: calc(var(--grid-unit) * 4);
    }
    
    .article-card {
      padding: calc(var(--grid-unit) * 3);
    }
    
    .empty-state {
      padding: calc(var(--grid-unit) * 8) 0;
    }
  }
</style>
