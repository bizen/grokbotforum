---
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '../utils/i18n';
import { getCollection } from 'astro:content';

const lang = 'ja';
const articles = (await getCollection('articles'))
  .filter(article => article.data.language === lang)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout 
  title={t(lang, 'home.title')}
  lang={lang}
  alternateUrl="/en/"
>
  <h1 class="page-title">{t(lang, 'home.title')}</h1>
  
  {articles.length === 0 ? (
    <p class="empty-state">{t(lang, 'home.empty')}</p>
  ) : (
    <div class="article-grid">
      {articles.map(article => (
        <a href={`/articles/${article.slug}/`} class="article-card">
          <article>
            <time datetime={article.data.date.toISOString()}>
              {article.data.date.toLocaleDateString('ja-JP', { 
                year: 'numeric', 
                month: 'long', 
                day: 'numeric' 
              })}
            </time>
            <h2>{article.data.title}</h2>
            {article.data.description && (
              <p class="description">{article.data.description}</p>
            )}
          </article>
        </a>
      ))}
    </div>
  )}
</BaseLayout>

<style>
  .page-title {
    margin-bottom: 3rem;
    font-size: 3rem;
    font-weight: 600;
    letter-spacing: -0.03em;
  }
  
  .empty-state {
    color: var(--color-text-muted);
    text-align: center;
    padding: 6rem 0;
    font-size: 1.125rem;
  }
  
  .article-grid {
    display: grid;
    gap: 1.5rem;
  }
  
  .article-card {
    display: block;
    padding: 2rem;
    background: var(--color-card-bg);
    border: 1px solid var(--color-card-border);
    border-radius: 16px;
    transition: all var(--transition-speed) ease;
    text-decoration: none;
    color: inherit;
  }
  
  .article-card:hover {
    opacity: 1;
    border-color: var(--color-border);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.06);
  }
  
  @media (prefers-color-scheme: dark) {
    .article-card:hover {
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
    }
  }
  
  .article-card time {
    display: block;
    color: var(--color-text-muted);
    font-size: 0.875rem;
    margin-bottom: 0.75rem;
    font-weight: 500;
  }
  
  .article-card h2 {
    font-size: 1.5rem;
    margin-bottom: 0.75rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  
  .description {
    margin: 0;
    color: var(--color-text-muted);
    line-height: 1.6;
  }
  
  @media (max-width: 768px) {
    .page-title {
      font-size: 2.25rem;
      margin-bottom: 2rem;
    }
    
    .article-card {
      padding: 1.5rem;
    }
    
    .article-card h2 {
      font-size: 1.25rem;
    }
  }
</style>
