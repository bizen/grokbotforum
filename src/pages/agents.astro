---
import BaseLayout from '../layouts/BaseLayout.astro';
import CopyButton from '../components/CopyButton.astro';

const lang = 'ja';
const MCP_URL = 'https://grokbotforum.com/mcp';

const clients = [
  {
    name: 'Grok Bot',
    ja: 'Bot に URL を伝えて追加してもらいます。カタログにない MCP サーバーも URL で追加できます。',
    code: { ja: `次の MCP サーバーを追加して: ${MCP_URL}` },
  },
  {
    name: 'Claude Code',
    ja: 'ターミナルで次を実行します。',
    code: { ja: `claude mcp add --transport http grokbotforum ${MCP_URL}` },
  },
  {
    name: 'Cursor',
    ja: '.cursor/mcp.json（またはグローバルの ~/.cursor/mcp.json）に追加します。',
    code: {
      ja: JSON.stringify({ mcpServers: { grokbotforum: { url: MCP_URL } } }, null, 2),
    },
  },
  {
    name: 'Claude（claude.ai）',
    ja: '設定のコネクタから「カスタムコネクタを追加」を選び、URL を入力します。',
    code: { ja: MCP_URL },
  },
];

const tools = [
  { name: 'search', ja: 'ドキュメント解説・ボット役割・プロンプトを検索（日本語・英語）' },
  { name: 'get_page', ja: '1 ページの本文（Markdown）と出典。ボット役割は最初のメッセージつき' },
  { name: 'list_pages', ja: 'コレクションのページ一覧' },
  { name: 'official_docs_map', ja: '公式ページ ↔ 日本語解説の対応表（更新日つき）' },
  { name: 'quick_facts', ja: 'プラン・端末・上限などの早見表（出典と確認日つき）' },
];

const endpoints = [
  { path: '/llms.txt', ja: 'LLM 向けのサイト目次' },
  { path: '/llms-full.txt', ja: '全コンテンツを 1 ファイルで' },
  { path: '/index.json', ja: '全ページのメタデータと早見表' },
  { path: '/docs.json', ja: 'コレクションごとの本文つき JSON（docs / bots / prompts など）' },
];

const t = {
    title: 'エージェント向け',
    lede: 'grokbotforum は、人が読まなくても役に立つことを目指しています。MCP サーバーにつなげば、Grok Bot や Claude、Cursor が、このサイトの日本語解説を出典つきで使えます。',
    server: 'MCP サーバー',
    serverNote: 'Streamable HTTP・認証なし・読み取り専用。無料で使えます。',
    connect: '接続方法',
    tools: 'ツール',
    roles: 'すぐ使える GBF Bot',
    rolesLede: 'Grok Bot に貼るだけで使える役割です。',
    navi: 'GBF ナビ',
    naviNote: 'Grok Bot の質問に、このサイトを出典にして日本語で答える',
    watcher: 'GBF 更新ウォッチャー',
    watcherNote: '公式ドキュメントの変更を毎日チェックして報告する',
    other: 'その他のエンドポイント',
    otherNote: 'ページの URL の末尾の / を .json に変えると、そのページを JSON で取得できます。',
  };

---

<BaseLayout lang={lang} title={t.title} description={t.lede}>
  <div class="container page reveal">
    <h1>{t.title}</h1>
    <p class="lede">{t.lede}</p>

    <section>
      <h2>{t.server}</h2>
      <div class="url">
        <code>{MCP_URL}</code>
        <CopyButton lang={lang} text={MCP_URL} />
      </div>
      <p class="note">{t.serverNote}</p>
    </section>

    <section>
      <h2>{t.connect}</h2>
      <div class="clients">
        {clients.map((c) => (
          <figure>
            <figcaption>
              <span><strong>{c.name}</strong> — {c.ja}</span>
              <CopyButton lang={lang} text={c.code.ja} />
            </figcaption>
            <pre><code>{c.code.ja}</code></pre>
          </figure>
        ))}
      </div>
    </section>

    <section>
      <h2>{t.tools}</h2>
      <dl class="tools">
        {tools.map((tool) => (
          <div>
            <dt><code>{tool.name}</code></dt>
            <dd>{tool.ja}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section>
      <h2>{t.roles}</h2>
      <p class="note">{t.rolesLede}</p>
      <ul class="roles">
        <li><a href="/bots/gbf-navi/"><strong>{t.navi}</strong><span>{t.naviNote}</span></a></li>
        <li><a href="/bots/gbf-docs-watcher/"><strong>{t.watcher}</strong><span>{t.watcherNote}</span></a></li>
      </ul>
    </section>

    <section>
      <h2>{t.other}</h2>
      <dl class="tools">
        {endpoints.map((e) => (
          <div>
            <dt><a href={e.path}><code>{e.path}</code></a></dt>
            <dd>{e.ja}</dd>
          </div>
        ))}
      </dl>
      <p class="note">{t.otherNote}</p>
    </section>
  </div>
</BaseLayout>

<style>
  .page {
    max-width: calc(var(--w-content) + var(--gutter) * 2);
    padding-top: var(--s-8);
  }
  h1 {
    font-size: clamp(32px, 4vw, 48px);
  }
  .lede {
    margin-top: var(--s-4);
    color: var(--fg-muted);
    font-size: 17px;
  }
  section {
    margin-top: var(--s-8);
  }
  h2 {
    margin-bottom: var(--s-4);
    font-size: 20px;
  }
  .note {
    margin-top: var(--s-2);
    color: var(--fg-muted);
    font-size: 14px;
  }
  section > .note:first-of-type:not(:last-child) {
    margin: 0 0 var(--s-4);
  }
  .url {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
    padding: var(--s-3) var(--s-3) var(--s-3) var(--s-4);
    border: 1px solid var(--border-strong);
    border-radius: var(--r-md);
    background: var(--bg-subtle);
  }
  .url code {
    overflow: hidden;
    font-size: 15px;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .clients {
    display: grid;
    gap: var(--s-4);
  }
  figure {
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    overflow: hidden;
  }
  figcaption {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
    padding: var(--s-2) var(--s-2) var(--s-2) var(--s-4);
    border-bottom: 1px solid var(--border);
    color: var(--fg-muted);
    font-size: 14px;
  }
  figcaption strong {
    color: var(--fg);
    font-weight: 600;
  }
  pre {
    padding: var(--s-4);
    overflow-x: auto;
    background: var(--bg-subtle);
    font-size: 13px;
    line-height: 1.6;
  }
  .tools div {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: var(--s-4);
    padding: var(--s-3) 0;
    border-bottom: 1px solid var(--border);
    font-size: 15px;
  }
  .tools dd {
    color: var(--fg-muted);
  }
  .tools a {
    text-decoration: none;
  }
  .roles {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-3);
    padding: 0;
    list-style: none;
  }
  .roles a {
    display: grid;
    gap: var(--s-1);
    height: 100%;
    padding: var(--s-4);
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    text-decoration: none;
    transition: background-color var(--dur) var(--ease);
  }
  .roles a:hover {
    background: var(--bg-hover);
  }
  .roles span {
    color: var(--fg-muted);
    font-size: 14px;
  }
  @media (max-width: 640px) {
    .tools div {
      grid-template-columns: 1fr;
      gap: var(--s-1);
    }
    .roles {
      grid-template-columns: 1fr;
    }
  }
</style>
