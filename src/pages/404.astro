---
import BaseLayout from '../layouts/BaseLayout.astro';
import { COLLECTION_META, getNavCollections } from '../lib/content';

const lang = 'ja';
const sections = (await getNavCollections(lang)).map((c) => ({ href: `/${c}/`, ...COLLECTION_META[c][lang] }));
---

<BaseLayout lang={lang} title="ページが見つかりません" description="お探しのページは見つかりませんでした。">
  <div class="container page reveal">
    <p class="code tabular">404</p>
    <h1>ページが見つかりません</h1>
    <p class="lede">URL が変わったか、ページが削除された可能性があります。検索するか、下の一覧から探してください。</p>
    <div class="actions">
      <button type="button" class="btn btn-primary" data-search-open>サイト内を検索</button>
      <a class="btn btn-secondary" href="/">ホームへ</a>
    </div>
    <ul class="sections">
      {sections.map((s) => (
        <li>
          <a href={s.href}>{s.label}</a>
          <span>{s.description}</span>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>

<style>
  .page {
    max-width: calc(var(--w-content) + var(--gutter) * 2);
    padding-top: var(--s-9);
    padding-bottom: var(--s-9);
  }
  .code {
    color: var(--fg-subtle);
    font: 500 14px var(--font-mono);
    letter-spacing: 0.1em;
  }
  h1 {
    margin-top: var(--s-2);
    font-size: clamp(32px, 4vw, 48px);
  }
  .lede {
    margin-top: var(--s-4);
    color: var(--fg-muted);
    font-size: 17px;
    line-height: 1.7;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    margin-top: var(--s-6);
  }
  .sections {
    margin-top: var(--s-8);
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--border);
  }
  .sections li {
    display: grid;
    gap: 2px;
    padding: var(--s-4) 0;
    border-bottom: 1px solid var(--border);
  }
  .sections a {
    font-weight: 600;
    text-decoration: none;
  }
  .sections a:hover {
    text-decoration: underline;
  }
  .sections span {
    color: var(--fg-muted);
    font-size: 14px;
  }
</style>
