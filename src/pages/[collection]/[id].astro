---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CopyButton from '../../components/CopyButton.astro';
import { OFFICIAL_DOCS, OFFICIAL_DOCS_BASE } from '../../data/official-docs';
import {
  COLLECTION_META,
  getAllItems,
  getItems,
  itemDate,
  itemJsonPath,
  itemPath,
  splitId,
  type Item,
} from '../../lib/content';
import { formatDate, isoDate, localizedPath, t } from '../../lib/i18n';

export async function getStaticPaths() {
  const items = await getAllItems();
  return items.map((item) => {
    return { params: { collection: item.collection, id: splitId(item.id).slug }, props: { item } };
  });
}

const { item } = Astro.props as { item: Item };
const { lang } = splitId(item.id);
const { data } = item;
const meta = COLLECTION_META[item.collection][lang];
const { Content, headings } = await render(item);
const toc = headings.filter((h) => h.depth === 2);
const jsonPath = itemJsonPath(item);
const date = itemDate(item);
const url = new URL(itemPath(item), Astro.site).href;
const shareUrl = `https://x.com/intent/post?${new URLSearchParams({ text: `${data.title}｜Grok Bot Forum`, url })}`;

// Docs pages read as one book: a sidebar in the official order, plus previous / next.
const slug = splitId(item.id).slug;
const docOrder = OFFICIAL_DOCS.flatMap((g) => g.pages);
const ourDocs = new Set((await getItems('docs', lang)).map((i) => splitId(i.id).slug));
const docHref = (s: string) => (ourDocs.has(s) ? `/docs/${s}/` : `${OFFICIAL_DOCS_BASE}${s}`);
const docIndex = item.collection === 'docs' ? docOrder.findIndex((p) => p.slug === slug) : -1;
const prevDoc = docIndex > 0 ? docOrder[docIndex - 1] : undefined;
const nextDoc = docIndex >= 0 && docIndex < docOrder.length - 1 ? docOrder[docIndex + 1] : undefined;

// Glossary links both ways: terms explained on a docs page, and the docs pages behind a term.
type GlossaryItem = Extract<Item, { collection: 'glossary' }>;
const glossary = (await getItems('glossary', lang)) as GlossaryItem[];
const pageTerms =
  item.collection === 'docs'
    ? glossary.filter((g) => g.data.docs.includes(slug)).sort((a, b) => a.data.yomi.localeCompare(b.data.yomi, 'ja'))
    : [];
const termDocs = item.collection === 'glossary' ? docOrder.filter((p) => item.data.docs.includes(p.slug)) : [];

// The text a reader will copy straight into Grok Bot.
const copyBlock = item.collection === 'prompts' ? { label: t(lang, 'common.prompt'), text: data.prompt } : null;

const schemaType = {
  docs: 'TechArticle',
  reference: 'TechArticle',
  glossary: 'DefinedTerm',
  news: 'NewsArticle',
  bots: 'SoftwareApplication',
  prompts: 'CreativeWork',
}[item.collection];
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': schemaType,
  [item.collection === 'bots' || item.collection === 'glossary' ? 'name' : 'headline']: data.title,
  description: data.summary,
  inLanguage: lang,
  url,
  dateModified: isoDate(data.updated),
  ...(item.collection === 'news' ? { datePublished: isoDate(data.published) } : {}),
  ...(item.collection === 'glossary'
    ? { alternateName: data.en, inDefinedTermSet: new URL('/glossary/', Astro.site).href }
    : {}),
  ...(item.collection === 'bots'
    ? { applicationCategory: 'Grok Bot', author: { '@type': 'Person', name: data.creator }, sameAs: data.marketplace }
    : {}),
  citation: data.sources.map((s) => s.url),
  isPartOf: { '@type': 'WebSite', name: 'Grok Bot Forum', url: new URL('/', Astro.site).href },
  ...(item.collection === 'news' && data.image ? { image: new URL(data.image.src, Astro.site).href } : {}),
};
const ogImage = item.collection === 'news' && data.image ? data.image.src : `/og/${item.collection}/${splitId(item.id).slug}.png`;
---

<BaseLayout
  lang={lang}
  title={data.title}
  description={data.summary}
  jsonPath={jsonPath}
  ogType="article"
  ogImage={ogImage}
  jsonLd={jsonLd}
>
  <div class:list={['container layout reveal', { 'has-docnav': docIndex >= 0 }]}>
    {docIndex >= 0 && (
      <nav class="docnav" aria-label="ドキュメント">
        {OFFICIAL_DOCS.map((group) => (
          <div>
            <h2>{group.group}</h2>
            <ul>
              {group.pages.map((p) => (
                <li>
                  <a href={docHref(p.slug)} aria-current={p.slug === slug ? 'page' : undefined}>
                    {p.title}{!ourDocs.has(p.slug) && <span aria-hidden="true"> ↗</span>}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
    )}
    <article>
      {docIndex >= 0 && (
        <details class="docnav-mobile">
          <summary>ドキュメントの目次</summary>
          <ol>
            {docOrder.map((p) => (
              <li><a href={docHref(p.slug)} aria-current={p.slug === slug ? 'page' : undefined}>{p.title}</a></li>
            ))}
          </ol>
        </details>
      )}
      <header>
        <a class="crumb" href={localizedPath(`/${item.collection}/`, lang)}>{meta.label}</a>
        <h1>{data.title}</h1>
        {item.collection === 'news' && data.image && (
          <figure class="hero">
            <img src={data.image.src} alt={data.image.alt} width="1600" height="900" loading="eager" decoding="async" />
            {data.image.credit && (
              <figcaption>
                出典{' '}
                {data.image.creditUrl ? (
                  <a href={data.image.creditUrl} rel="noopener">{data.image.credit}</a>
                ) : data.image.credit}
              </figcaption>
            )}
          </figure>
        )}
        {item.collection === 'news' && !data.image && data.xPost && (
          <div class="x-embed">
            <blockquote class="twitter-tweet" data-dnt="true" data-theme="light">
              <a href={data.xPost}>View post on X</a>
            </blockquote>
            <script async src="https://platform.twitter.com/widgets.js" charset="utf-8" is:inline></script>
          </div>
        )}
        {item.collection === 'glossary' && (
          <p class="term-en">英語表記 <span lang="en">{data.en}</span><span aria-hidden="true">·</span>よみ {data.yomi}</p>
        )}
        <p class="lede">{data.summary}</p>
        <p class="meta">
          <span>
            {t(lang, item.collection === 'news' ? 'common.published' : 'common.updated')}
            {' '}<time datetime={isoDate(date)}>{formatDate(date, lang)}</time>
          </span>
          {data.sources.length > 0 && (
            <a href="#sources">{data.sources.length} {data.sources.length === 1 ? t(lang, 'common.sourceCount') : t(lang, 'common.sourcesCount')}</a>
          )}
        </p>
        {data.tags.length > 0 && (
          <div class="tags">{data.tags.map((tag) => <span class="chip">{tag}</span>)}</div>
        )}
      </header>

      {item.collection === 'docs' && (
        <aside class="official">
          <p>{t(lang, 'docs.notice')}</p>
          <a class="btn btn-secondary btn-sm" href={data.official} rel="noopener" hreflang="en">
            {t(lang, 'docs.official')} <span aria-hidden="true">↗</span>
          </a>
        </aside>
      )}

      {item.collection === 'bots' && (
        <aside class="market">
          <dl>
            <div><dt>{t(lang, 'bots.creator')}</dt><dd>{data.creator}</dd></div>
            <div><dt>{t(lang, 'bots.source')}</dt><dd>{data.team ? t(lang, 'bots.team') : t(lang, 'bots.community')}</dd></div>
          </dl>
          <div class="market-actions">
            {data.add && (
              <a class="btn btn-primary btn-sm" href={data.add} rel="noopener">{t(lang, 'bots.add')} <span aria-hidden="true">↗</span></a>
            )}
            <a class="btn btn-secondary btn-sm" href={data.marketplace} rel="noopener">{t(lang, 'bots.marketplace')} <span aria-hidden="true">↗</span></a>
          </div>
          <p>{t(lang, 'bots.notice')}</p>
        </aside>
      )}

      {(item.collection === 'bots' || item.collection === 'prompts') && data.apps.length > 0 && (
        <p class="apps">
          <span>{t(lang, 'common.apps')}</span>
          {data.apps.map((app) => <span class="chip">{app}</span>)}
        </p>
      )}

      {copyBlock && (
        <figure class="prompt">
          <figcaption>
            <span>{copyBlock.label}</span>
            <CopyButton lang={lang} text={copyBlock.text} />
          </figcaption>
          <pre><code>{copyBlock.text}</code></pre>
        </figure>
      )}

      <div class="prose">
        <Content />
      </div>

      {termDocs.length > 0 && (
        <section class="related">
          <h2>詳しい解説</h2>
          <ul>{termDocs.map((p) => <li><a href={docHref(p.slug)}>{p.title}</a></li>)}</ul>
        </section>
      )}

      {pageTerms.length > 0 && (
        <section class="related">
          <h2>このページの用語</h2>
          <div class="tags">
            {pageTerms.map((g) => <a class="chip" href={itemPath(g)} title={g.data.summary}>{g.data.title}</a>)}
          </div>
        </section>
      )}

      {(prevDoc || nextDoc) && (
        <nav class="pager" aria-label="前後のページ">
          {prevDoc ? (
            <a class="prev" href={docHref(prevDoc.slug)}><span>前へ</span>{prevDoc.title}</a>
          ) : <span />}
          {nextDoc && <a class="next" href={docHref(nextDoc.slug)}><span>次へ</span>{nextDoc.title}</a>}
        </nav>
      )}

      {data.sources.length > 0 && (
        <section class="sources" id="sources">
          <h2>{t(lang, 'common.sources')}</h2>
          <ol>
            {data.sources.map((s) => (
              <li>
                <a href={s.url} rel="noopener">{s.title}</a>
                <span>{new URL(s.url).host}</span>
              </li>
            ))}
          </ol>
        </section>
      )}
    </article>

    <aside>
      <div class="rail">
        {toc.length > 0 && (
          <nav aria-label={t(lang, 'common.onThisPage')}>
            <h2>{t(lang, 'common.onThisPage')}</h2>
            <ul>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ul>
          </nav>
        )}
        <div class="actions">
          <a class="btn btn-primary btn-sm" href={shareUrl} target="_blank" rel="noopener">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.8 3h3.1l-6.8 7.7L22 21h-6.2l-4.9-6.4L5.3 21H2.2l7.2-8.3L1.8 3h6.4l4.4 5.8L17.8 3Zm-1.1 16.2h1.7L7.4 4.7H5.6l11.1 14.5Z" /></svg>
            {t(lang, 'common.shareX')}
          </a>
          <CopyButton lang={lang} fetchJson={jsonPath} label={t(lang, 'common.copyMarkdown')} />
          <a class="btn btn-secondary btn-sm" href={jsonPath}>{t(lang, 'common.openJson')}</a>
        </div>
      </div>
    </aside>
  </div>
</BaseLayout>

<style>
  .layout {
    display: grid;
    grid-template-columns: minmax(0, var(--w-content)) 220px;
    justify-content: center;
    gap: var(--s-9);
    padding-top: var(--s-8);
  }
  article {
    min-width: 0;
  }

  /* Docs: book-style sidebar in the official order. */
  .layout.has-docnav {
    grid-template-columns: 200px minmax(0, var(--w-content)) 200px;
    gap: 40px;
  }
  .docnav {
    position: sticky;
    top: calc(var(--nav-h) + var(--s-6));
    align-self: start;
    display: grid;
    gap: var(--s-5);
    max-height: calc(100vh - var(--nav-h) - var(--s-8));
    overflow-y: auto;
    font-size: 13.5px;
  }
  .docnav h2 {
    margin-bottom: var(--s-2);
    color: var(--fg-subtle);
    font-size: 12px;
    font-weight: 500;
  }
  .docnav ul {
    display: grid;
    padding: 0;
    list-style: none;
  }
  .docnav a,
  .docnav-mobile a {
    display: block;
    padding: 5px 0 5px var(--s-3);
    border-left: 1px solid var(--border);
    color: var(--fg-muted);
    line-height: 1.4;
    text-decoration: none;
  }
  .docnav a:hover,
  .docnav-mobile a:hover {
    color: var(--fg);
  }
  .docnav a[aria-current='page'],
  .docnav-mobile a[aria-current='page'] {
    border-left-color: var(--fg);
    color: var(--fg);
    font-weight: 600;
  }
  .docnav-mobile {
    display: none;
    margin-bottom: var(--s-5);
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    font-size: 14px;
  }
  .docnav-mobile summary {
    padding: var(--s-3) var(--s-4);
    cursor: pointer;
    font-weight: 500;
  }
  .docnav-mobile ol {
    display: grid;
    padding: 0 var(--s-4) var(--s-3);
    list-style: none;
  }

  .hero {
    margin: var(--s-5) 0 0;
  }
  .hero img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border: 1px solid var(--border);
    border-radius: var(--r-md);
  }
  .hero figcaption {
    margin-top: var(--s-2);
    color: var(--fg-subtle);
    font-size: 13px;
  }
  .hero figcaption a {
    color: var(--fg-subtle);
  }
  .x-embed {
    margin: var(--s-5) 0 0;
  }

  .term-en {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    margin-top: var(--s-3);
    color: var(--fg-muted);
    font-size: 14px;
  }
  .term-en span[lang] {
    color: var(--fg);
    font-weight: 500;
  }

  .related {
    margin-top: var(--s-7);
  }
  .related h2 {
    margin-bottom: var(--s-3);
    font-size: 15px;
  }
  .related ul {
    display: grid;
    gap: var(--s-2);
    padding-left: 1.2em;
  }
  .related .chip {
    text-decoration: none;
  }
  .related .chip:hover {
    background: var(--bg-hover);
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--s-3);
    margin-top: var(--s-7);
  }
  .pager a {
    display: grid;
    gap: 2px;
    padding: var(--s-3) var(--s-4);
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    color: var(--fg);
    font-weight: 500;
    text-decoration: none;
    transition: background-color var(--dur) var(--ease);
  }
  .pager a:hover {
    background: var(--bg-hover);
  }
  .pager span {
    color: var(--fg-subtle);
    font-size: 12.5px;
    font-weight: 400;
  }
  .pager .next {
    grid-column: 2;
    text-align: right;
  }
  .crumb {
    color: var(--fg-muted);
    font-size: 14px;
    text-decoration: none;
  }
  .crumb:hover {
    color: var(--fg);
  }
  h1 {
    margin-top: var(--s-3);
    font-size: clamp(30px, 4vw, 44px);
  }
  .lede {
    margin-top: var(--s-4);
    color: var(--fg-muted);
    font-size: 18px;
    line-height: 1.6;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-1) var(--s-4);
    margin-top: var(--s-5);
    color: var(--fg-subtle);
    font-size: 14px;
  }
  .meta a {
    color: var(--fg-muted);
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    margin-top: var(--s-4);
  }
  header {
    padding-bottom: var(--s-6);
    margin-bottom: var(--s-6);
    border-bottom: 1px solid var(--border);
  }

  .official {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    flex-wrap: wrap;
    margin-bottom: var(--s-6);
    padding: var(--s-3) var(--s-3) var(--s-3) var(--s-4);
    border-left: 2px solid var(--border-strong);
    background: var(--bg-subtle);
    border-radius: 0 var(--r-md) var(--r-md) 0;
    color: var(--fg-muted);
    font-size: 14px;
  }
  .market {
    display: grid;
    gap: var(--s-3);
    margin-bottom: var(--s-6);
    padding: var(--s-4);
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    background: var(--bg-subtle);
    font-size: 14px;
  }
  .market dl {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-1) var(--s-6);
  }
  .market dl div {
    display: flex;
    gap: var(--s-2);
  }
  .market dt {
    color: var(--fg-subtle);
  }
  .market-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
  }
  .market p {
    color: var(--fg-muted);
    font-size: 13px;
  }
  .apps {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    flex-wrap: wrap;
    margin-bottom: var(--s-5);
    color: var(--fg-muted);
    font-size: 13px;
  }

  .prompt {
    margin-bottom: var(--s-7);
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    background: var(--bg-subtle);
    overflow: hidden;
  }
  .prompt figcaption {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--s-2) var(--s-2) var(--s-2) var(--s-4);
    border-bottom: 1px solid var(--border);
    color: var(--fg-muted);
    font-size: 13px;
  }
  .prompt pre {
    padding: var(--s-4);
    overflow-x: auto;
    font-size: 13.5px;
    line-height: 1.7;
    white-space: pre-wrap;
  }

  .sources {
    margin-top: var(--s-8);
    padding-top: var(--s-5);
    border-top: 1px solid var(--border);
  }
  .sources h2 {
    font-size: 15px;
  }
  .sources ol {
    display: grid;
    gap: var(--s-2);
    margin-top: var(--s-3);
    padding-left: 1.4em;
    color: var(--fg-subtle);
    font-size: 14px;
  }
  .sources span {
    margin-left: var(--s-2);
    color: var(--fg-subtle);
    font-size: 13px;
  }

  aside {
    position: relative;
  }
  .rail {
    position: sticky;
    top: calc(var(--nav-h) + var(--s-6));
    display: grid;
    gap: var(--s-6);
    font-size: 13px;
  }
  .rail h2 {
    margin-bottom: var(--s-2);
    color: var(--fg-subtle);
    font-size: 12px;
    font-weight: 500;
  }
  .rail ul {
    display: grid;
    gap: var(--s-2);
    padding: 0;
    list-style: none;
    line-height: 1.45;
  }
  .rail ul a {
    color: var(--fg-muted);
    text-decoration: none;
  }
  .rail ul a:hover {
    color: var(--fg);
  }
  .actions {
    display: grid;
    gap: var(--s-2);
    justify-items: start;
  }

  @media (max-width: 1200px) {
    .layout.has-docnav {
      grid-template-columns: minmax(0, var(--w-content)) 220px;
      gap: var(--s-9);
    }
    .docnav {
      display: none;
    }
    .docnav-mobile {
      display: block;
    }
  }
  @media (max-width: 1080px) {
    .layout,
    .layout.has-docnav {
      grid-template-columns: minmax(0, var(--w-content));
      gap: var(--s-7);
    }
    .rail {
      position: static;
    }
    .rail nav {
      display: none;
    }
    .actions {
      display: flex;
      flex-wrap: wrap;
    }
  }
  @media (max-width: 640px) {
    .layout {
      padding-top: var(--s-6);
    }
    .lede {
      font-size: 17px;
    }
  }
</style>
