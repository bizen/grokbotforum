---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t } from '../../utils/i18n';

const lang = 'en';
---

<BaseLayout 
  title={t(lang, 'templates.title')}
  lang={lang}
  alternateUrl="/templates/"
>
  <h1 class="page-title">{t(lang, 'templates.title')}</h1>
  
  <p class="empty-state">{t(lang, 'templates.empty')}</p>
</BaseLayout>

<style>
  .page-title {
    margin-bottom: 3rem;
    font-size: 3rem;
    font-weight: 600;
    letter-spacing: -0.03em;
  }
  
  .empty-state {
    color: var(--color-text-muted);
    text-align: center;
    padding: 6rem 0;
    font-size: 1.125rem;
  }
  
  @media (max-width: 768px) {
    .page-title {
      font-size: 2.25rem;
      margin-bottom: 2rem;
    }
  }
</style>
