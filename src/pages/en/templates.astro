---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t } from '../../utils/i18n';

const lang = 'en';
---

<BaseLayout 
  title={t(lang, 'templates.title')}
  lang={lang}
  alternateUrl="/templates/"
>
  <h1>{t(lang, 'templates.title')}</h1>
  
  <p class="empty-state">{t(lang, 'templates.empty')}</p>
</BaseLayout>

<style>
  h1 {
    margin-bottom: 2rem;
  }
  
  .empty-state {
    color: #666;
    font-style: italic;
    text-align: center;
    padding: 3rem 0;
  }
</style>
