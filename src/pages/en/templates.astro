---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t } from '../../utils/i18n';

const lang = 'en';
---

<BaseLayout 
  title={t(lang, 'templates.title')}
  lang={lang}
  alternateUrl="/templates/"
>
  <h1 class="page-title">{t(lang, 'templates.title')}</h1>
  
  <p class="empty-state">{t(lang, 'templates.empty')}</p>
</BaseLayout>

<style>
  .page-title {
    margin-bottom: calc(var(--grid-unit) * 8);
    font-size: clamp(40px, 6vw, 64px);
    font-weight: 700;
    line-height: 1.0625;
  }
  
  .empty-state {
    color: var(--color-text-secondary);
    text-align: center;
    padding: calc(var(--grid-unit) * 12) 0;
    font-size: 17px;
  }
  
  @media (max-width: 734px) {
    .page-title {
      margin-bottom: calc(var(--grid-unit) * 4);
    }
    
    .empty-state {
      padding: calc(var(--grid-unit) * 8) 0;
    }
  }
</style>
