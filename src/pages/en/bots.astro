---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t } from '../../utils/i18n';
import recommendedBots from '../../data/recommended-bots.json';

const lang = 'en';

interface Bot {
  name: string;
  job: string;
  link: string;
}

const bots = recommendedBots as Bot[];
---

<BaseLayout 
  title={t(lang, 'bots.title')}
  lang={lang}
  alternateUrl="/bots/"
>
  <h1 class="page-title">{t(lang, 'bots.title')}</h1>
  
  {bots.length === 0 ? (
    <p class="empty-state">{t(lang, 'bots.empty')}</p>
  ) : (
    <div class="bot-grid">
      {bots.map(bot => (
        <div class="bot-card">
          <article>
            <h2>{bot.name}</h2>
            <p class="job">
              <span class="job-label">{t(lang, 'bots.job')}</span>
              {bot.job}
            </p>
            <a href={bot.link} target="_blank" rel="noopener noreferrer" class="bot-link">
              {bot.link.replace(/^https?:\/\//, '').replace(/\/$/, '')}
            </a>
          </article>
        </div>
      ))}
    </div>
  )}
</BaseLayout>

<style>
  .page-title {
    margin-bottom: 3rem;
    font-size: 3rem;
    font-weight: 600;
    letter-spacing: -0.03em;
  }
  
  .empty-state {
    color: var(--color-text-muted);
    text-align: center;
    padding: 6rem 0;
    font-size: 1.125rem;
  }
  
  .bot-grid {
    display: grid;
    gap: 1.5rem;
  }
  
  .bot-card {
    padding: 2rem;
    background: var(--color-card-bg);
    border: 1px solid var(--color-card-border);
    border-radius: 16px;
    transition: all var(--transition-speed) ease;
  }
  
  .bot-card:hover {
    border-color: var(--color-border);
  }
  
  .bot-card h2 {
    font-size: 1.5rem;
    margin-bottom: 1rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  
  .job {
    margin-bottom: 1rem;
    color: var(--color-text);
    line-height: 1.6;
  }
  
  .job-label {
    display: block;
    color: var(--color-text-muted);
    font-size: 0.875rem;
    margin-bottom: 0.25rem;
    font-weight: 500;
  }
  
  .bot-link {
    display: inline-block;
    color: var(--color-text-muted);
    font-size: 0.875rem;
    word-break: break-all;
    text-decoration: underline;
    text-decoration-color: var(--color-border);
    text-underline-offset: 3px;
    transition: all var(--transition-speed) ease;
  }
  
  .bot-link:hover {
    color: var(--color-text);
    text-decoration-color: var(--color-text-muted);
  }
  
  @media (max-width: 768px) {
    .page-title {
      font-size: 2.25rem;
      margin-bottom: 2rem;
    }
    
    .bot-card {
      padding: 1.5rem;
    }
    
    .bot-card h2 {
      font-size: 1.25rem;
    }
  }
</style>
