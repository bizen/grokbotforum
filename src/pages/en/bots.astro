---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t } from '../../utils/i18n';
import recommendedBots from '../../data/recommended-bots.json';

const lang = 'en';

interface Bot {
  name: string;
  job: string;
  link: string;
}

const bots = recommendedBots as Bot[];
---

<BaseLayout 
  title={t(lang, 'bots.title')}
  lang={lang}
  alternateUrl="/bots/"
>
  <h1 class="page-title">{t(lang, 'bots.title')}</h1>
  
  {bots.length === 0 ? (
    <p class="empty-state">{t(lang, 'bots.empty')}</p>
  ) : (
    <div class="bot-grid">
      {bots.map(bot => (
        <div class="bot-card">
          <article>
            <h2>{bot.name}</h2>
            <p class="job">
              <span class="job-label">{t(lang, 'bots.job')}</span>
              {bot.job}
            </p>
            <a href={bot.link} target="_blank" rel="noopener noreferrer" class="bot-link">
              {bot.link.replace(/^https?:\/\//, '').replace(/\/$/, '')}
            </a>
          </article>
        </div>
      ))}
    </div>
  )}
</BaseLayout>

<style>
  .page-title {
    margin-bottom: calc(var(--grid-unit) * 8);
    font-size: clamp(40px, 6vw, 64px);
    font-weight: 700;
    line-height: 1.0625;
  }
  
  .empty-state {
    color: var(--color-text-secondary);
    text-align: center;
    padding: calc(var(--grid-unit) * 12) 0;
    font-size: 17px;
  }
  
  .bot-grid {
    display: grid;
    gap: calc(var(--grid-unit) * 3);
    max-width: var(--reading-width);
  }
  
  .bot-card {
    padding: calc(var(--grid-unit) * 4);
    background: var(--color-card-bg);
    border: 1px solid var(--color-border);
    border-radius: 28px;
    transition: all var(--transition-speed) ease;
  }
  
  .bot-card:hover {
    border-color: var(--color-text-secondary);
  }
  
  .bot-card h2 {
    font-size: clamp(24px, 3vw, 32px);
    margin-bottom: calc(var(--grid-unit) * 3);
    font-weight: 600;
    line-height: 1.1428571429;
  }
  
  .job {
    margin-bottom: calc(var(--grid-unit) * 3);
    color: var(--color-text);
    font-size: 17px;
    line-height: inherit;
  }
  
  .job-label {
    display: block;
    color: var(--color-text-secondary);
    font-size: 14px;
    margin-bottom: calc(var(--grid-unit) * 1);
    font-weight: 400;
  }
  
  .bot-link {
    display: inline-flex;
    align-items: center;
    color: var(--color-accent);
    font-size: 14px;
    word-break: break-all;
    text-decoration: none;
    min-height: 44px;
  }
  
  .bot-link::after {
    content: " ›";
    margin-left: 0.25em;
    transition: transform var(--transition-speed) ease;
    display: inline-block;
  }
  
  .bot-link:hover {
    text-decoration: underline;
    opacity: 0.8;
  }
  
  .bot-link:hover::after {
    transform: translateX(2px);
  }
  
  @media (max-width: 734px) {
    .page-title {
      margin-bottom: calc(var(--grid-unit) * 4);
    }
    
    .bot-card {
      padding: calc(var(--grid-unit) * 3);
    }
    
    .empty-state {
      padding: calc(var(--grid-unit) * 8) 0;
    }
  }
</style>
