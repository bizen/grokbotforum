---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t } from '../../utils/i18n';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map(article => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await article.render();

const lang = article.data.language;
const isJapanese = lang === 'ja';

let alternateUrl: string | undefined;
if (article.data.translationSlug) {
  alternateUrl = isJapanese 
    ? `/en/articles/${article.data.translationSlug}/`
    : `/articles/${article.data.translationSlug}/`;
}
---

<BaseLayout 
  title={article.data.title}
  description={article.data.description}
  lang={lang}
  alternateUrl={alternateUrl}
  ogType="article"
>
  <article class="article">
    <header>
      <h1>{article.data.title}</h1>
      <time datetime={article.data.date.toISOString()}>
        {article.data.date.toLocaleDateString(isJapanese ? 'ja-JP' : 'en-US', { 
          year: 'numeric', 
          month: 'long', 
          day: 'numeric' 
        })}
      </time>
      {alternateUrl && (
        <p class="translation-link">
          <a href={alternateUrl}>
            {isJapanese ? '→ English version' : '→ 日本語版'}
          </a>
        </p>
      )}
    </header>
    
    <div class="content">
      <Content />
    </div>
    
    {article.data.sources.length > 0 && (
      <footer class="sources">
        <h2>{t(lang, 'article.sources')}</h2>
        <ul>
          {article.data.sources.map(source => (
            <li>
              <a href={source} target="_blank" rel="noopener noreferrer">
                {source}
              </a>
            </li>
          ))}
        </ul>
      </footer>
    )}
  </article>
</BaseLayout>

<style>
  .article {
    max-width: 680px;
  }
  
  .article header {
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--color-border);
  }
  
  .article h1 {
    font-size: 2.5rem;
    margin-bottom: 1rem;
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.2;
  }
  
  time {
    display: block;
    color: var(--color-text-muted);
    font-size: 0.9375rem;
    font-weight: 500;
  }
  
  .translation-link {
    margin-top: 1rem;
    font-size: 0.9375rem;
  }
  
  .translation-link a {
    color: var(--color-text-muted);
    text-decoration: underline;
    text-decoration-color: var(--color-border);
    text-underline-offset: 3px;
  }
  
  .translation-link a:hover {
    color: var(--color-text);
  }
  
  .content {
    margin-bottom: 4rem;
    font-size: 1.0625rem;
    line-height: 1.8;
  }
  
  .content :global(h2) {
    margin-top: 3rem;
    margin-bottom: 1.25rem;
    font-size: 1.75rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  
  .content :global(h3) {
    margin-top: 2rem;
    margin-bottom: 1rem;
    font-size: 1.375rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  
  .content :global(p) {
    margin-bottom: 1.5rem;
  }
  
  .content :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 12px;
    margin: 2rem 0;
  }
  
  .content :global(blockquote) {
    border-left: 3px solid var(--color-border);
    padding-left: 1.5rem;
    margin: 2rem 0;
    color: var(--color-text-muted);
    font-style: italic;
  }
  
  .content :global(a) {
    color: var(--color-text);
    text-decoration: underline;
    text-decoration-color: var(--color-border);
    text-underline-offset: 3px;
  }
  
  .content :global(a:hover) {
    text-decoration-color: var(--color-text-muted);
  }
  
  .sources {
    margin-top: 4rem;
    padding: 2rem;
    background: var(--color-card-bg);
    border: 1px solid var(--color-card-border);
    border-radius: 12px;
  }
  
  .sources h2 {
    font-size: 1.125rem;
    margin-bottom: 1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  
  .sources ul {
    list-style: none;
    padding: 0;
  }
  
  .sources li {
    margin-bottom: 0.75rem;
    word-break: break-all;
  }
  
  .sources li:last-child {
    margin-bottom: 0;
  }
  
  .sources a {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    text-decoration: underline;
    text-decoration-color: var(--color-border);
    text-underline-offset: 3px;
  }
  
  .sources a:hover {
    color: var(--color-text);
  }
  
  @media (max-width: 768px) {
    .article h1 {
      font-size: 2rem;
    }
    
    .content {
      font-size: 1rem;
    }
    
    .content :global(h2) {
      font-size: 1.5rem;
      margin-top: 2.5rem;
    }
    
    .content :global(h3) {
      font-size: 1.25rem;
      margin-top: 1.75rem;
    }
    
    .sources {
      padding: 1.5rem;
    }
  }
</style>
