---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t } from '../../utils/i18n';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map(article => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await article.render();

const lang = article.data.language;
const isJapanese = lang === 'ja';

let alternateUrl: string | undefined;
if (article.data.translationSlug) {
  alternateUrl = isJapanese 
    ? `/en/articles/${article.data.translationSlug}/`
    : `/articles/${article.data.translationSlug}/`;
}
---

<BaseLayout 
  title={article.data.title}
  description={article.data.description}
  lang={lang}
  alternateUrl={alternateUrl}
  ogType="article"
>
  <article class="article">
    <header>
      <h1>{article.data.title}</h1>
      <time datetime={article.data.date.toISOString()}>
        {article.data.date.toLocaleDateString(isJapanese ? 'ja-JP' : 'en-US', { 
          year: 'numeric', 
          month: 'long', 
          day: 'numeric' 
        })}
      </time>
      {alternateUrl && (
        <p class="translation-link">
          <a href={alternateUrl}>
            {isJapanese ? '→ English version' : '→ 日本語版'}
          </a>
        </p>
      )}
    </header>
    
    <div class="content">
      <Content />
    </div>
    
    {article.data.sources.length > 0 && (
      <footer class="sources">
        <h2>{t(lang, 'article.sources')}</h2>
        <ul>
          {article.data.sources.map(source => (
            <li>
              <a href={source} target="_blank" rel="noopener noreferrer">
                {source}
              </a>
            </li>
          ))}
        </ul>
      </footer>
    )}
  </article>
</BaseLayout>

<style>
  .article {
    max-width: var(--reading-width);
  }
  
  .article header {
    margin-bottom: calc(var(--grid-unit) * 6);
    padding-bottom: calc(var(--grid-unit) * 4);
    border-bottom: 1px solid var(--color-border);
  }
  
  .article h1 {
    font-size: clamp(32px, 5vw, 56px);
    margin-bottom: calc(var(--grid-unit) * 3);
    font-weight: 700;
    line-height: 1.0625;
  }
  
  time {
    display: block;
    color: var(--color-text-secondary);
    font-size: 14px;
    font-weight: 400;
    min-height: auto;
  }
  
  .translation-link {
    margin-top: calc(var(--grid-unit) * 2);
    font-size: 14px;
  }
  
  .translation-link a {
    color: var(--color-accent);
    text-decoration: none;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }
  
  .translation-link a::after {
    content: " ›";
    margin-left: 0.25em;
    transition: transform var(--transition-speed) ease;
    display: inline-block;
  }
  
  .translation-link a:hover {
    text-decoration: underline;
    opacity: 0.8;
  }
  
  .translation-link a:hover::after {
    transform: translateX(2px);
  }
  
  .content {
    margin-bottom: calc(var(--grid-unit) * 8);
    font-size: 17px;
  }
  
  .content :global(h2) {
    margin-top: calc(var(--grid-unit) * 6);
    margin-bottom: calc(var(--grid-unit) * 3);
    font-size: clamp(28px, 4vw, 40px);
    font-weight: 600;
    line-height: 1.1;
  }
  
  .content :global(h3) {
    margin-top: calc(var(--grid-unit) * 5);
    margin-bottom: calc(var(--grid-unit) * 2);
    font-size: clamp(21px, 3vw, 28px);
    font-weight: 600;
    line-height: 1.1428571429;
  }
  
  .content :global(p) {
    margin-bottom: calc(var(--grid-unit) * 3);
  }
  
  .content :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 18px;
    margin: calc(var(--grid-unit) * 4) 0;
  }
  
  .content :global(blockquote) {
    border-left: 3px solid var(--color-border);
    padding-left: calc(var(--grid-unit) * 3);
    margin: calc(var(--grid-unit) * 4) 0;
    color: var(--color-text-secondary);
    font-style: italic;
  }
  
  .content :global(a) {
    color: var(--color-accent);
    text-decoration: none;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }
  
  .content :global(a:hover) {
    text-decoration: underline;
    opacity: 0.8;
  }
  
  .sources {
    margin-top: calc(var(--grid-unit) * 8);
    padding: calc(var(--grid-unit) * 4);
    background: var(--color-card-bg);
    border: 1px solid var(--color-border);
    border-radius: 18px;
  }
  
  .sources h2 {
    font-size: 21px;
    margin-bottom: calc(var(--grid-unit) * 2);
    font-weight: 600;
    line-height: 1.1428571429;
  }
  
  .sources ul {
    list-style: none;
    padding: 0;
  }
  
  .sources li {
    margin-bottom: calc(var(--grid-unit) * 2);
    word-break: break-all;
  }
  
  .sources li:last-child {
    margin-bottom: 0;
  }
  
  .sources a {
    font-size: 14px;
    color: var(--color-accent);
    text-decoration: none;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }
  
  .sources a:hover {
    text-decoration: underline;
    opacity: 0.8;
  }
  
  @media (max-width: 734px) {
    .article header {
      margin-bottom: calc(var(--grid-unit) * 4);
      padding-bottom: calc(var(--grid-unit) * 3);
    }
    
    .content {
      margin-bottom: calc(var(--grid-unit) * 6);
    }
    
    .sources {
      padding: calc(var(--grid-unit) * 3);
    }
  }
</style>
